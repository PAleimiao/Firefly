---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="视频剪辑">
	<div class="card-base p-6 md:p-8 mb-4">
		<div class="flex items-center gap-3 mb-2">
			<div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white text-lg">🎬</div>
			<h1 class="text-2xl font-bold">在线视频剪辑</h1>
		</div>
		<p class="text-75 mb-4">
			纯浏览器的视频剪辑：多段素材拼接、裁剪入点出点、滤镜特效、文字水印、贴纸贴图、淡黑转场、音量调节，最后一键<b>本地合成导出 webm</b>。
		</p>
		<div class="rounded-lg border-l-4 border-amber-400 bg-amber-400/10 px-4 py-3 text-sm text-75">
			⚠️ 剪辑与合成<b>全程在你的设备本地完成，视频不会上传</b>。导出为 1280×720 webm，时长 = 各片段裁剪后总和。
		</div>
	</div>

	<div class="grid grid-cols-1 lg:grid-cols-[340px_1fr] gap-4">
		<div class="flex flex-col gap-4">
			<div class="card-base p-4">
				<h2 class="font-bold mb-3">📹 素材导入</h2>
				<input id="ve-add" type="file" accept="video/*" multiple class="w-full text-sm mb-3" />
				<div id="ve-clips" class="flex flex-col gap-3"></div>
			</div>

			<div class="card-base p-4">
				<h2 class="font-bold mb-3">✍️ 文字水印</h2>
				<div class="grid grid-cols-2 gap-2 text-sm mb-2">
					<input id="ve-t-text" placeholder="文字内容" class="col-span-2 border-(--line-divider) border rounded px-2 py-1 bg-transparent" />
					<label>起(秒)<input id="ve-t-in" type="number" min="0" step="0.1" value="0" class="w-full border-(--line-divider) border rounded px-2 py-1 bg-transparent" /></label>
					<label>止(秒)<input id="ve-t-out" type="number" min="0" step="0.1" value="3" class="w-full border-(--line-divider) border rounded px-2 py-1 bg-transparent" /></label>
					<label>X%<input id="ve-t-x" type="number" min="0" max="100" value="50" class="w-full border-(--line-divider) border rounded px-2 py-1 bg-transparent" /></label>
					<label>Y%<input id="ve-t-y" type="number" min="0" max="100" value="90" class="w-full border-(--line-divider) border rounded px-2 py-1 bg-transparent" /></label>
					<label>字号<input id="ve-t-size" type="number" min="10" max="200" value="42" class="w-full border-(--line-divider) border rounded px-2 py-1 bg-transparent" /></label>
					<label>颜色<input id="ve-t-color" type="color" value="#ffffff" class="w-full h-8 bg-transparent" /></label>
				</div>
				<button id="ve-t-add" class="w-full px-3 py-2 rounded-lg border-(--line-divider) border text-sm mb-2">＋ 添加文字</button>
				<div id="ve-texts" class="flex flex-col gap-1 text-xs"></div>
			</div>

			<div class="card-base p-4">
				<h2 class="font-bold mb-3">🖼️ 贴纸 / 贴图（自行导入）</h2>
				<input id="ve-i-file" type="file" accept="image/*" class="w-full text-sm mb-2" />
				<div class="grid grid-cols-2 gap-2 text-sm mb-2">
					<label>起(秒)<input id="ve-i-in" type="number" min="0" step="0.1" value="0" class="w-full border-(--line-divider) border rounded px-2 py-1 bg-transparent" /></label>
					<label>止(秒)<input id="ve-i-out" type="number" min="0" step="0.1" value="3" class="w-full border-(--line-divider) border rounded px-2 py-1 bg-transparent" /></label>
					<label>X%<input id="ve-i-x" type="number" min="0" max="100" value="85" class="w-full border-(--line-divider) border rounded px-2 py-1 bg-transparent" /></label>
					<label>Y%<input id="ve-i-y" type="number" min="0" max="100" value="15" class="w-full border-(--line-divider) border rounded px-2 py-1 bg-transparent" /></label>
					<label class="col-span-2">宽度%<input id="ve-i-w" type="number" min="1" max="100" value="15" class="w-full border-(--line-divider) border rounded px-2 py-1 bg-transparent" /></label>
				</div>
				<button id="ve-i-add" class="w-full px-3 py-2 rounded-lg border-(--line-divider) border text-sm mb-2">＋ 添加贴纸</button>
				<div id="ve-imgs" class="flex flex-col gap-1 text-xs"></div>
			</div>

			<div class="card-base p-4">
				<h2 class="font-bold mb-3">⚙️ 全局</h2>
				<label class="text-sm flex items-center gap-2 mb-3"><input id="ve-fade" type="checkbox" checked /> 片段间淡黑转场（0.4s）</label>
				<button id="ve-preview" class="w-full px-3 py-2 rounded-lg bg-(--primary) text-white text-sm mb-2">▶ 预览合成</button>
				<button id="ve-export" class="w-full px-3 py-2 rounded-lg bg-red-500 text-white text-sm">⬇ 导出 webm</button>
				<div id="ve-status" class="text-xs text-50 mt-2">先导入视频素材</div>
			</div>
		</div>

		<div class="card-base p-2">
			<canvas id="ve-canvas" width="1280" height="720" class="w-full rounded-lg bg-black"></canvas>
			<div class="text-xs text-50 mt-2 px-2">合成分辨率 1280×720 · 画面自适应裁剪填满（cover）</div>
		</div>
	</div>
</MainGridLayout>

<script is:inline>
(function () {
	function $(id) { return document.getElementById(id); }

	const W = 1280, H = 720;
	const canvas = $("ve-canvas");
	const ctx = canvas.getContext("2d");
	const statusEl = $("ve-status");

	const FILTERS = {
		none: { name: "原片", css: "none" },
		vivid: { name: "鲜明", css: "saturate(1.5) contrast(1.12)" },
		film: { name: "胶片", css: "sepia(0.32) contrast(1.06) brightness(1.03) saturate(1.1)" },
		bw: { name: "黑白", css: "grayscale(1) contrast(1.1)" },
		retro: { name: "复古", css: "sepia(0.6) contrast(0.92) brightness(0.98)" },
		cold: { name: "冷调", css: "saturate(1.05) brightness(1.02) hue-rotate(-12deg)" },
		warm: { name: "暖阳", css: "sepia(0.22) saturate(1.35) brightness(1.05)" },
	};

	let clips = []; // {id,name,url,el,dur,in,out,filter,vol,gain}
	let texts = []; // {text,in,out,x,y,size,color}
	let imgs = [];  // {img,name,in,out,x,y,w}
	let seq = 0;
	let busy = false;
	let stopFlag = false;

	let audioCtx = null;
	let mediaDest = null;

	function ensureAudio(el) {
		if (!audioCtx) {
			audioCtx = new (window.AudioContext || window.webkitAudioContext)();
			mediaDest = audioCtx.createMediaStreamDestination();
		}
		if (!el._veGain) {
			const src = audioCtx.createMediaElementSource(el);
			const gain = audioCtx.createGain();
			src.connect(gain);
			gain.connect(audioCtx.destination);
			gain.connect(mediaDest);
			el._veGain = gain;
		}
		return el._veGain;
	}

	// ---------- 素材列表 ----------
	$("ve-add").addEventListener("change", (e) => {
		for (const f of e.target.files) {
			const url = URL.createObjectURL(f);
			const el = document.createElement("video");
			el.src = url;
			el.crossOrigin = "anonymous";
			el.playsInline = true;
			el.muted = false;
			el.preload = "auto";
			el.onloadedmetadata = () => {
				clips.push({ id: ++seq, name: f.name, url, el, dur: el.duration, in: 0, out: el.duration, filter: "none", vol: 1 });
				renderClips();
				statusEl.textContent = "共 " + clips.length + " 段素材，总时长 " + totalDur().toFixed(1) + " 秒";
			};
		}
		e.target.value = "";
	});

	function totalDur() {
		return clips.reduce((s, c) => s + Math.max(0, c.out - c.in), 0);
	}

	function renderClips() {
		const box = $("ve-clips");
		box.innerHTML = "";
		clips.forEach((c, i) => {
			const div = document.createElement("div");
			div.className = "border-(--line-divider) border rounded-lg p-2 text-xs";
			const title = document.createElement("div");
			title.className = "font-bold mb-1 truncate";
			title.textContent = (i + 1) + ". " + c.name + "（" + c.dur.toFixed(1) + "s）";
			div.appendChild(title);

			const grid = document.createElement("div");
			grid.className = "grid grid-cols-2 gap-1 mb-1";
			grid.appendChild(numInput("入点", c.in, 0, c.dur, 0.1, (v) => { c.in = Math.min(v, c.out); }));
			grid.appendChild(numInput("出点", c.out, 0, c.dur, 0.1, (v) => { c.out = Math.max(v, c.in); }));
			div.appendChild(grid);

			const row = document.createElement("div");
			row.className = "flex gap-1 items-center";
			const sel = document.createElement("select");
			sel.className = "flex-1 border-(--line-divider) border rounded px-1 py-0.5 bg-transparent";
			for (const [k, f] of Object.entries(FILTERS)) {
				const op = document.createElement("option");
				op.value = k;
				op.textContent = f.name;
				if (c.filter === k) op.selected = true;
				sel.appendChild(op);
			}
			sel.onchange = () => { c.filter = sel.value; };
			row.appendChild(sel);

			const vol = document.createElement("input");
			vol.type = "range";
			vol.min = 0; vol.max = 1; vol.step = 0.05; vol.value = c.vol;
			vol.title = "音量";
			vol.className = "w-16";
			vol.oninput = () => { c.vol = parseFloat(vol.value); };
			row.appendChild(vol);

			row.appendChild(miniBtn("↑", () => { if (i > 0) { [clips[i - 1], clips[i]] = [clips[i], clips[i - 1]]; renderClips(); } }));
			row.appendChild(miniBtn("↓", () => { if (i < clips.length - 1) { [clips[i + 1], clips[i]] = [clips[i], clips[i + 1]]; renderClips(); } }));
			row.appendChild(miniBtn("✕", () => { clips.splice(i, 1); renderClips(); }));
			div.appendChild(row);
			box.appendChild(div);
		});
	}

	function numInput(label, val, min, max, step, cb) {
		const l = document.createElement("label");
		l.textContent = label;
		const inp = document.createElement("input");
		inp.type = "number";
		inp.min = min; inp.max = max; inp.step = step; inp.value = val;
		inp.className = "w-full border-(--line-divider) border rounded px-1 py-0.5 bg-transparent";
		inp.onchange = () => cb(parseFloat(inp.value) || 0);
		l.appendChild(inp);
		return l;
	}
	function miniBtn(t, cb) {
		const b = document.createElement("button");
		b.textContent = t;
		b.className = "px-2 py-0.5 rounded border-(--line-divider) border";
		b.onclick = cb;
		return b;
	}

	// ---------- 文字 ----------
	$("ve-t-add").addEventListener("click", () => {
		const t = $("ve-t-text").value.trim();
		if (!t) return;
		texts.push({
			text: t,
			in: parseFloat($("ve-t-in").value) || 0,
			out: parseFloat($("ve-t-out").value) || 3,
			x: parseFloat($("ve-t-x").value) || 50,
			y: parseFloat($("ve-t-y").value) || 90,
			size: parseFloat($("ve-t-size").value) || 42,
			color: $("ve-t-color").value,
		});
		renderTexts();
	});
	function renderTexts() {
		const box = $("ve-texts");
		box.innerHTML = "";
		texts.forEach((t, i) => {
			const row = document.createElement("div");
			row.className = "flex justify-between items-center border-(--line-divider) border rounded px-2 py-1";
			const s = document.createElement("span");
			s.className = "truncate";
			s.textContent = t.text + "（" + t.in + "-" + t.out + "s）";
			row.appendChild(s);
			row.appendChild(miniBtn("✕", () => { texts.splice(i, 1); renderTexts(); }));
			box.appendChild(row);
		});
	}

	// ---------- 贴纸 ----------
	let pendingImg = null;
	$("ve-i-file").addEventListener("change", (e) => {
		const f = e.target.files[0];
		if (!f) return;
		const img = new Image();
		img.onload = () => { pendingImg = { img, name: f.name }; statusEl.textContent = "贴纸已选：" + f.name + "，点「添加贴纸」"; };
		img.src = URL.createObjectURL(f);
	});
	$("ve-i-add").addEventListener("click", () => {
		if (!pendingImg) return;
		imgs.push({
			img: pendingImg.img,
			name: pendingImg.name,
			in: parseFloat($("ve-i-in").value) || 0,
			out: parseFloat($("ve-i-out").value) || 3,
			x: parseFloat($("ve-i-x").value) || 85,
			y: parseFloat($("ve-i-y").value) || 15,
			w: parseFloat($("ve-i-w").value) || 15,
		});
		pendingImg = null;
		renderImgs();
	});
	function renderImgs() {
		const box = $("ve-imgs");
		box.innerHTML = "";
		imgs.forEach((t, i) => {
			const row = document.createElement("div");
			row.className = "flex justify-between items-center border-(--line-divider) border rounded px-2 py-1";
			const s = document.createElement("span");
			s.className = "truncate";
			s.textContent = t.name + "（" + t.in + "-" + t.out + "s）";
			row.appendChild(s);
			row.appendChild(miniBtn("✕", () => { imgs.splice(i, 1); renderImgs(); }));
			box.appendChild(row);
		});
	}

	// ---------- 合成播放 ----------
	function drawCover(video) {
		const vw = video.videoWidth, vh = video.videoHeight;
		if (!vw || !vh) return;
		const s = Math.max(W / vw, H / vh);
		const dw = vw * s, dh = vh * s;
		ctx.drawImage(video, (W - dw) / 2, (H - dh) / 2, dw, dh);
	}

	function drawOverlays(t) {
		ctx.filter = "none";
		for (const o of texts) {
			if (t < o.in || t > o.out) continue;
			ctx.font = "bold " + o.size + "px sans-serif";
			ctx.textAlign = "center";
			ctx.textBaseline = "middle";
			ctx.lineWidth = Math.max(2, o.size / 12);
			ctx.strokeStyle = "rgba(0,0,0,0.7)";
			ctx.strokeText(o.text, (o.x / 100) * W, (o.y / 100) * H);
			ctx.fillStyle = o.color;
			ctx.fillText(o.text, (o.x / 100) * W, (o.y / 100) * H);
		}
		for (const o of imgs) {
			if (t < o.in || t > o.out) continue;
			const w = (o.w / 100) * W;
			const h = (w / o.img.width) * o.img.height;
			ctx.drawImage(o.img, (o.x / 100) * W - w / 2, (o.y / 100) * H - h / 2, w, h);
		}
	}

	async function playComposition(recording) {
		if (!clips.length) { statusEl.textContent = "没有素材"; return false; }
		if (busy) return false;
		busy = true;
		stopFlag = false;
		if (audioCtx) await audioCtx.resume();

		let recorder = null;
		const chunks = [];
		if (recording) {
			const stream = canvas.captureStream(30);
			if (mediaDest) mediaDest.stream.getAudioTracks().forEach((tr) => stream.addTrack(tr));
			recorder = new MediaRecorder(stream, { mimeType: "video/webm" });
			recorder.ondataavailable = (ev) => { if (ev.data.size) chunks.push(ev.data); };
			recorder.start();
		}

		const fade = $("ve-fade").checked ? 0.4 : 0;
		let compT = 0;
		const total = totalDur();

		for (const c of clips) {
			if (stopFlag) break;
			const el = c.el;
			const gain = ensureAudio(el);
			clips.forEach((o) => { if (o.el._veGain) o.el._veGain.gain.value = 0; });
			gain.gain.value = c.vol;
			el.currentTime = c.in;
			try { await el.play(); } catch (e) { /* 忽略自动播放限制 */ }
			const segDur = c.out - c.in;
			const segStart = compT;

			await new Promise((resolve) => {
				function frame() {
					if (stopFlag) { resolve(); return; }
					const local = el.currentTime - c.in;
					const t = segStart + local;
					ctx.filter = FILTERS[c.filter].css;
					drawCover(el);
					ctx.filter = "none";
					if (fade > 0) {
						const aIn = Math.min(1, local / fade);
						const aOut = Math.min(1, (segDur - local) / fade);
						const a = 1 - Math.min(aIn, aOut);
						if (a > 0) {
							ctx.fillStyle = "rgba(0,0,0," + Math.min(1, a) + ")";
							ctx.fillRect(0, 0, W, H);
						}
					}
					drawOverlays(t);
					statusEl.textContent = (recording ? "导出中 " : "预览中 ") + Math.min(100, (t / total) * 100).toFixed(0) + "%";
					if (el.currentTime >= c.out || el.ended) { resolve(); return; }
					requestAnimationFrame(frame);
				}
				frame();
			});
			el.pause();
			compT += segDur;
		}

		clips.forEach((o) => { if (o.el._veGain) o.el._veGain.gain.value = 0; });

		if (recording && recorder) {
			await new Promise((r) => { recorder.onstop = r; recorder.stop(); });
			const blob = new Blob(chunks, { type: "video/webm" });
			const a = document.createElement("a");
			a.href = URL.createObjectURL(blob);
			a.download = "edited.webm";
			a.click();
			statusEl.textContent = "已导出 edited.webm（" + (blob.size / 1048576).toFixed(1) + " MB）";
		} else {
			statusEl.textContent = stopFlag ? "已停止" : "预览完成";
		}
		busy = false;
		return true;
	}

	$("ve-preview").addEventListener("click", () => {
		if (busy) { stopFlag = true; return; }
		$("ve-preview").textContent = "⏹ 停止";
		playComposition(false).finally(() => { $("ve-preview").textContent = "▶ 预览合成"; });
	});
	$("ve-export").addEventListener("click", () => {
		if (busy) return;
		statusEl.textContent = "导出中，请勿切换标签页…";
		playComposition(true);
	});
})();
</script>
