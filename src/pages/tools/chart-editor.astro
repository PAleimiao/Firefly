---
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="谱面编辑器" description="在浏览器里制作 Phira / RPE 谱面">
  <div class="mx-auto w-full max-w-[1500px] px-3 sm:px-6 py-4">
    <div class="flex items-center gap-3 mb-3">
      <a href="/tools/" class="text-sm text-neutral-500 dark:text-neutral-400 hover:text-(--primary)">← 工具工坊</a>
      <span class="text-xs text-neutral-400 dark:text-neutral-500">谱面编辑器</span>
    </div>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative w-full">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
          <Icon is:inline name="material-symbols:edit-note" class="text-[1.5rem]"></Icon>
        </div>
        <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">谱面编辑器</div>
      </div>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        直接在浏览器里写谱：点画布加音符、拖动调位置、导出 <b>RPE JSON</b>（Phira 可直接读）。所有数据只存在本地，不上传。
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-4">
        <!-- 左侧设置 -->
        <div class="space-y-3">
          <div class="rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-4">
            <div class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 mb-3">谱面信息</div>
            <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">曲名</label>
            <input id="ce-name" type="text" placeholder="曲名" class="w-full mb-2 rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) px-2 py-1.5 text-sm" />
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">曲师</label>
                <input id="ce-composer" type="text" class="w-full rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) px-2 py-1.5 text-sm" />
              </div>
              <div>
                <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">谱师</label>
                <input id="ce-charter" type="text" class="w-full rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) px-2 py-1.5 text-sm" />
              </div>
              <div>
                <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">难度</label>
                <input id="ce-level" type="text" placeholder="IN 15" class="w-full rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) px-2 py-1.5 text-sm" />
              </div>
              <div>
                <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">BPM</label>
                <input id="ce-bpm" type="number" min="1" step="0.1" value="120" class="w-full rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) px-2 py-1.5 text-sm" />
              </div>
            </div>
            <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1 mt-2">偏移 (ms)</label>
            <input id="ce-offset" type="number" step="1" value="0" class="w-full rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) px-2 py-1.5 text-sm" />
          </div>

          <div class="rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-4">
            <div class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 mb-3">工具</div>
            <div class="grid grid-cols-2 gap-2 mb-3" id="ce-tools">
              <button data-tool="0" class="ce-tool px-2 py-2 rounded-lg border text-xs font-medium col-span-2">选择 / 框选</button>
              <button data-tool="1" class="ce-tool px-2 py-2 rounded-lg border text-xs font-medium">Tap 点击</button>
              <button data-tool="2" class="ce-tool px-2 py-2 rounded-lg border text-xs font-medium">Drag 按住</button>
              <button data-tool="3" class="ce-tool px-2 py-2 rounded-lg border text-xs font-medium">Hold 长条</button>
              <button data-tool="4" class="ce-tool px-2 py-2 rounded-lg border text-xs font-medium">Flick 滑动</button>
            </div>
            <div class="grid grid-cols-2 gap-2 mb-3" id="ce-layers">
              <button data-above="1" class="ce-layer px-2 py-2 rounded-lg border text-xs font-medium">判定线上</button>
              <button data-above="0" class="ce-layer px-2 py-2 rounded-lg border text-xs font-medium">判定线下</button>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">吸附</label>
                <select id="ce-snap" class="w-full rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) px-2 py-1.5 text-sm">
                  <option value="1">1 拍</option>
                  <option value="0.5">1/2</option>
                  <option value="0.25" selected>1/4</option>
                  <option value="0.125">1/8</option>
                </select>
              </div>
              <div>
                <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">Hold 长度(拍)</label>
                <input id="ce-hold" type="number" min="0.125" step="0.125" value="1" class="w-full rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) px-2 py-1.5 text-sm" />
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-4 space-y-2">
            <div class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 mb-1">操作</div>
            <div class="grid grid-cols-2 gap-2">
              <button id="ce-play" class="px-3 py-2 rounded-lg bg-(--primary) text-white dark:text-black/70 text-sm font-medium hover:opacity-85 active:scale-95 transition">播放</button>
              <button id="ce-stop" class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) text-sm font-medium hover:opacity-85 transition">停止</button>
              <button id="ce-import" class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) text-sm font-medium hover:opacity-85 transition">导入 JSON</button>
              <button id="ce-export" class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) text-sm font-medium hover:opacity-85 transition">导出 RPE</button>
              <button id="ce-audio" class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) text-sm font-medium hover:opacity-85 transition">载入音频</button>
              <button id="ce-new" class="px-3 py-2 rounded-lg bg-(--primary) text-white dark:text-black/70 text-sm font-medium hover:opacity-85 active:scale-95 transition">新建谱面</button>
              <button id="ce-clear" class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) text-sm font-medium hover:opacity-85 transition">清空</button>
            </div>
            <input id="ce-import-file" type="file" accept=".json,application/json" class="hidden" />
            <input id="ce-audio-file" type="file" accept="audio/*" class="hidden" />
            <div class="text-xs text-neutral-500 dark:text-neutral-400 pt-1" id="ce-status">就绪</div>
          </div>
        </div>

        <!-- 右侧画布 -->
        <div class="space-y-2 min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs text-neutral-500 dark:text-neutral-400" id="ce-count">0 个音符</span>
            <span class="w-px h-4 bg-(--line-divider)"></span>
            <button id="ce-zoom-in" class="px-2 py-1 rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) text-xs">放大</button>
            <button id="ce-zoom-out" class="px-2 py-1 rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) text-xs">缩小</button>
            <button id="ce-fit" class="px-2 py-1 rounded-lg bg-(--btn-regular-bg) border border-(--line-divider) text-xs">适应</button>
            <button id="ce-del" class="px-2 py-1 rounded-lg bg-(--btn-regular-bg) border border-red-500/40 text-red-500 text-xs">删除选中</button>
            <span class="ml-auto text-xs text-neutral-400 dark:text-neutral-500">左键加音符 · 拖动改位置 · Delete 删除 · 空格播放</span>
          </div>
          <div id="ce-drop-hint" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 pointer-events-none">
            <div class="rounded-xl bg-(--card-bg) border border-(--primary) px-6 py-4 text-sm text-neutral-900 dark:text-neutral-100">松开导入谱面 JSON 或音频</div>
          </div>
          <canvas id="ce-canvas" class="w-full rounded-xl touch-none select-none" style="height:460px;user-select:none;-webkit-user-select:none;touch-action:none"></canvas>
          <div class="text-xs text-neutral-500 dark:text-neutral-400" id="ce-hover">横轴=拍数，纵轴=位置 (-675 ~ 675)</div>

          <!-- 判定线动画 -->
          <div class="rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-4 mt-3">
            <div class="flex items-center gap-2 mb-2">
              <div class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">判定线动画</div>
              <span class="text-xs text-neutral-500 dark:text-neutral-400">在播放头位置加关键帧，导出成判定线事件</span>
            </div>
            <div class="grid grid-cols-3 gap-3 mb-2">
              <div>
                <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">左端抬高 <span id="ce-tl-val" class="font-mono">0</span></label>
                <input id="ce-line-tl" type="range" min="-90" max="90" step="1" value="0" class="w-full accent-(--primary)" />
              </div>
              <div>
                <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">整体上下 <span id="ce-ly-val" class="font-mono">0</span></label>
                <input id="ce-line-y" type="range" min="-450" max="450" step="5" value="0" class="w-full accent-(--primary)" />
              </div>
              <div>
                <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">右端抬高 <span id="ce-tr-val" class="font-mono">0</span></label>
                <input id="ce-line-tr" type="range" min="-90" max="90" step="1" value="0" class="w-full accent-(--primary)" />
              </div>
            </div>
            <div class="flex items-center gap-2 mb-2">
              <label class="text-xs text-neutral-500 dark:text-neutral-400">不透明度 <span id="ce-la-val" class="font-mono">255</span></label>
              <input id="ce-line-alpha" type="range" min="0" max="255" step="5" value="255" class="flex-1 accent-(--primary)" />
              <button id="ce-line-add" class="px-3 py-2 rounded-lg bg-(--primary) text-white dark:text-black/70 text-sm font-medium hover:opacity-85 active:scale-95 transition">加关键帧</button>
            </div>
            <canvas id="ce-line-preview" class="w-full rounded-lg" style="height:120px"></canvas>
            <div id="ce-line-keys" class="mt-2 max-h-32 overflow-auto"></div>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>
</Layout>

<script>
  type Note = { type: number; beat: number; endBeat: number; x: number; above: number };

  const $ = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;
  const canvas = $<HTMLCanvasElement>("ce-canvas");
  const ctx = canvas.getContext("2d")!;
  const statusEl = $("ce-status");
  const countEl = $("ce-count");
  const hoverEl = $("ce-hover");

  const PAD = 28;
  const POS_MAX = 675;
  const COLORS: Record<number, string> = { 1: "#2dd4bf", 2: "#fbbf24", 3: "#60a5fa", 4: "#f472b6" };

  let notes: Note[] = [];
  let selected = -1;
  const sel = new Set<number>();
  let tiltL = 0;
  let tiltR = 0;
  let boxSel: { x0: number; y0: number; x1: number; y1: number } | null = null;
  let dragSnapshot: { i: number; beat: number; x: number }[] = [];
  let dragOrigin = { beat: 0, x: 0 };
  let tool = 1;
  let above = 1;
  let snap = 0.25;
  let holdLen = 1;
  let bpm = 120;
  let offsetMs = 0;
  let viewStart = 0;
  let viewSpan = 16;
  let playing = false;
  let playSec = 0;
  let raf = 0;
  let lastTs = 0;
  let dragging = false;
  let audioCtx: AudioContext | null = null;
  let audioBuffer: AudioBuffer | null = null;
  let audioSrc: AudioBufferSourceNode | null = null;

  // 判定线关键帧
  type LineKey = { beat: number; y: number; rot: number; alpha: number };
  let lineKeys: LineKey[] = [{ beat: 0, y: 0, rot: 0, alpha: 255 }];

  const setStatus = (m: string) => { statusEl.textContent = m; };
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  const snapBeat = (b: number) => Math.round(b / snap) * snap;
  const beatToSec = (b: number) => (b * 60) / bpm;
  const secToBeat = (s: number) => (s * bpm) / 60;

  function gcd(a: number, b: number): number { return b ? gcd(b, a % b) : a; }
  function trip(beat: number): number[] {
    const den = 8;
    let whole = Math.floor(beat + 1e-9);
    let num = Math.round((beat - whole) * den);
    if (num >= den) { whole += 1; num = 0; }
    if (num === 0) return [whole, 0, 1];
    const g = gcd(num, den);
    return [whole, num / g, den / g];
  }
  function parseTrip(v: unknown): number | null {
    if (Array.isArray(v) && v.length >= 3) {
      const den = Number(v[2]) || 1;
      return Number(v[0]) + Number(v[1]) / den;
    }
    if (typeof v === "number" && Number.isFinite(v)) return v;
    return null;
  }

  /* ---------- 坐标 ---------- */
  function pxPerBeat(): number {
    const w = canvas.clientWidth;
    return (w - PAD * 2) / viewSpan;
  }
  function beatToX(b: number): number { return PAD + (b - viewStart) * pxPerBeat(); }
  function xToBeat(x: number): number { return viewStart + (x - PAD) / pxPerBeat(); }
  function posToY(pos: number): number {
    const h = canvas.clientHeight;
    return PAD + ((POS_MAX - pos) / (POS_MAX * 2)) * (h - PAD * 2);
  }
  function yToPos(y: number): number {
    const h = canvas.clientHeight;
    return POS_MAX - ((y - PAD) / (h - PAD * 2)) * (POS_MAX * 2);
  }

  /* ---------- 绘制 ---------- */
  function draw() {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) {
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
    }
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = "#0f1115";
    ctx.fillRect(0, 0, w, h);

    // 网格
    const startBeat = Math.floor(viewStart);
    const endBeat = Math.ceil(viewStart + viewSpan);
    for (let b = startBeat; b <= endBeat; b++) {
      const x = beatToX(b);
      if (x < 0 || x > w) continue;
      ctx.strokeStyle = b % 4 === 0 ? "#2b303c" : "#1d222b";
      ctx.beginPath();
      ctx.moveTo(x, PAD);
      ctx.lineTo(x, h - PAD);
      ctx.stroke();
      if (b % 4 === 0) {
        ctx.fillStyle = "#6b7280";
        ctx.font = "11px ui-monospace, monospace";
        ctx.fillText(String(b), x + 3, h - PAD + 14);
      }
    }
    // 中线
    ctx.strokeStyle = "#333a47";
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(PAD, posToY(0));
    ctx.lineTo(w - PAD, posToY(0));
    ctx.stroke();
    ctx.setLineDash([]);

    if (!notes.length) {
      ctx.fillStyle = "#4b5563";
      ctx.font = "14px sans-serif";
      ctx.textAlign = "center";
      ctx.fillText("点击画布添加音符，或把谱面 .json / 音频拖进来", w / 2, h / 2);
      ctx.textAlign = "left";
    }

    // 音符
    notes.forEach((n, i) => {
      const x = beatToX(n.beat);
      const y = posToY(n.x);
      if (x < -40 || x > w + 40) return;
      const color = COLORS[n.type] || "#fff";
      ctx.strokeStyle = color;
      ctx.fillStyle = color;
      ctx.lineWidth = 2;
      if (n.type === 3 && n.endBeat > n.beat) {
        const x2 = beatToX(n.endBeat);
        ctx.globalAlpha = 0.35;
        ctx.fillRect(x, y - 4, Math.max(6, x2 - x), 8);
        ctx.globalAlpha = 1;
      }
      if (n.type === 1) {
        ctx.beginPath(); ctx.arc(x, y, 5, 0, Math.PI * 2);
        n.above ? ctx.fill() : ctx.stroke();
      } else if (n.type === 2) {
        const s = 5;
        n.above ? ctx.fillRect(x - s, y - s, s * 2, s * 2) : ctx.strokeRect(x - s, y - s, s * 2, s * 2);
      } else if (n.type === 4) {
        ctx.beginPath(); ctx.moveTo(x, y - 7); ctx.lineTo(x + 6, y + 5); ctx.lineTo(x - 6, y + 5); ctx.closePath();
        n.above ? ctx.fill() : ctx.stroke();
      } else if (n.type === 3) {
        ctx.beginPath(); ctx.arc(x, y, 5, 0, Math.PI * 2);
        n.above ? ctx.fill() : ctx.stroke();
      }
      if (sel.has(i)) {
        ctx.strokeStyle = "#ffffff";
        ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.arc(x, y, 9, 0, Math.PI * 2); ctx.stroke();
      }
    });

    // 框选矩形
    if (boxSel) {
      const x = Math.min(boxSel.x0, boxSel.x1);
      const y = Math.min(boxSel.y0, boxSel.y1);
      const w2 = Math.abs(boxSel.x1 - boxSel.x0);
      const h2 = Math.abs(boxSel.y1 - boxSel.y0);
      ctx.fillStyle = "rgba(45,212,191,0.12)";
      ctx.fillRect(x, y, w2, h2);
      ctx.strokeStyle = "#2dd4bf";
      ctx.setLineDash([4, 3]);
      ctx.strokeRect(x, y, w2, h2);
      ctx.setLineDash([]);
    }

    // 播放头
    if (playing || playSec > 0) {
      const bx = beatToX(secToBeat(playSec));
      if (bx >= PAD && bx <= w - PAD) {
        ctx.strokeStyle = "#ef4444";
        ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(bx, PAD); ctx.lineTo(bx, h - PAD); ctx.stroke();
      }
    }
  }

  /* ---------- 命中 / 编辑 ---------- */
  function hitTest(x: number, y: number): number {
    for (let i = notes.length - 1; i >= 0; i--) {
      const nx = beatToX(notes[i].beat);
      const ny = posToY(notes[i].x);
      if (Math.hypot(nx - x, ny - y) < 10) return i;
    }
    return -1;
  }

  function beginDrag(px: number, py: number) {
    dragOrigin = { beat: xToBeat(px), x: yToPos(py) };
    dragSnapshot = [...sel].map((i) => ({ i, beat: notes[i].beat, x: notes[i].x }));
  }

  canvas.addEventListener("pointerdown", (e) => {
    e.preventDefault();
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    const hit = hitTest(x, y);
    canvas.setPointerCapture(e.pointerId);

    if (tool === 0) {
      if (hit >= 0) {
        if (e.shiftKey) {
          if (sel.has(hit)) sel.delete(hit); else sel.add(hit);
        } else {
          sel.clear();
          sel.add(hit);
        }
        selected = hit;
        dragging = true;
        beginDrag(x, y);
      } else {
        if (!e.shiftKey) sel.clear();
        boxSel = { x0: x, y0: y, x1: x, y1: y };
        selected = -1;
      }
    } else if (hit >= 0) {
      sel.clear();
      sel.add(hit);
      selected = hit;
      dragging = true;
      beginDrag(x, y);
    } else {
      const beat = Math.max(0, snapBeat(xToBeat(x)));
      const pos = clamp(yToPos(y), -POS_MAX, POS_MAX);
      notes.push({ type: tool, beat, endBeat: tool === 3 ? beat + holdLen : beat, x: Math.round(pos), above });
      selected = notes.length - 1;
      sel.clear();
      sel.add(selected);
      dragging = true;
      beginDrag(x, y);
      setStatus(`添加 ${["选择", "Tap", "Drag", "Hold", "Flick"][tool]} 于第 ${beat.toFixed(2)} 拍`);
    }
    refreshCount();
    draw();
  });

  canvas.addEventListener("pointermove", (e) => {
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    hoverEl.textContent = `拍 ${xToBeat(x).toFixed(2)} · 位置 ${Math.round(yToPos(y))} · 已选 ${sel.size}`;
    if (boxSel) {
      boxSel.x1 = x;
      boxSel.y1 = y;
      draw();
      return;
    }
    if (!dragging || !dragSnapshot.length) return;
    const dBeat = snapBeat(xToBeat(x)) - snapBeat(dragOrigin.beat);
    const dPos = Math.round(clamp(yToPos(y), -POS_MAX, POS_MAX) - dragOrigin.x);
    for (const s of dragSnapshot) {
      const n = notes[s.i];
      n.beat = Math.max(0, snapBeat(s.beat + dBeat));
      n.x = clamp(s.x + dPos, -POS_MAX, POS_MAX);
    }
    draw();
  });

  const endDrag = () => {
    if (boxSel) {
      const x0 = Math.min(boxSel.x0, boxSel.x1);
      const x1 = Math.max(boxSel.x0, boxSel.x1);
      const y0 = Math.min(boxSel.y0, boxSel.y1);
      const y1 = Math.max(boxSel.y0, boxSel.y1);
      if (x1 - x0 > 4 || y1 - y0 > 4) {
        notes.forEach((n, i) => {
          const nx = beatToX(n.beat);
          const ny = posToY(n.x);
          if (nx >= x0 && nx <= x1 && ny >= y0 && ny <= y1) sel.add(i);
        });
        setStatus(`框选 ${sel.size} 个音符`);
      }
      boxSel = null;
    }
    dragging = false;
    dragSnapshot = [];
    draw();
  };
  canvas.addEventListener("pointerup", endDrag);
  canvas.addEventListener("pointercancel", endDrag);

  canvas.addEventListener("wheel", (e) => {
    e.preventDefault();
    const rect = canvas.getBoundingClientRect();
    const anchor = xToBeat(e.clientX - rect.left);
    const factor = e.deltaY > 0 ? 1.25 : 0.8;
    viewSpan = clamp(viewSpan * factor, 2, 128);
    viewStart = Math.max(0, anchor - (anchor - viewStart) * factor);
    draw();
  }, { passive: false });

  // 拖拽平移（右键或中键）
  canvas.addEventListener("contextmenu", (e) => e.preventDefault());

  window.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement | null;
    if (t && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
    const n = selected >= 0 ? notes[selected] : null;
    if (e.key === " ")
      { e.preventDefault(); togglePlay(); return; }
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "a") {
      e.preventDefault();
      sel.clear();
      notes.forEach((_, i) => sel.add(i));
      setStatus(`已全选 ${sel.size} 个音符`);
      draw();
      return;
    }
    if (e.key === "Delete" || e.key === "Backspace") {
      if (sel.size) {
        e.preventDefault();
        for (const i of [...sel].sort((a, b) => b - a)) notes.splice(i, 1);
        sel.clear();
        selected = -1;
        refreshCount();
        draw();
        setStatus("已删除选中音符");
      }
      return;
    }
    if (!n) return;
    if (e.key === "ArrowUp") { n.x = clamp(n.x + 10, -POS_MAX, POS_MAX); e.preventDefault(); draw(); }
    else if (e.key === "ArrowDown") { n.x = clamp(n.x - 10, -POS_MAX, POS_MAX); e.preventDefault(); draw(); }
    else if (e.key === "ArrowRight") { n.beat += snap; if (n.type === 3) n.endBeat += snap; e.preventDefault(); draw(); }
    else if (e.key === "ArrowLeft") { n.beat = Math.max(0, n.beat - snap); if (n.type === 3) n.endBeat = Math.max(n.beat + snap, n.endBeat - snap); e.preventDefault(); draw(); }
  });

  /* ---------- 工具状态 ---------- */
  function refreshTools() {
    document.querySelectorAll<HTMLButtonElement>(".ce-tool").forEach((b) => {
      const on = Number(b.dataset.tool) === tool;
      b.className = "ce-tool px-2 py-2 rounded-lg border text-xs font-medium transition " + (on ? "border-(--primary) text-(--primary) bg-(--primary)/10" : "border-(--line-divider)");
    });
    document.querySelectorAll<HTMLButtonElement>(".ce-layer").forEach((b) => {
      const on = Number(b.dataset.above) === above;
      b.className = "ce-layer px-2 py-2 rounded-lg border text-xs font-medium transition " + (on ? "border-(--primary) text-(--primary) bg-(--primary)/10" : "border-(--line-divider)");
    });
  }
  document.querySelectorAll<HTMLButtonElement>(".ce-tool").forEach((b) => {
    b.addEventListener("click", () => { tool = Number(b.dataset.tool) || 1; refreshTools(); });
  });
  document.querySelectorAll<HTMLButtonElement>(".ce-layer").forEach((b) => {
    b.addEventListener("click", () => { above = Number(b.dataset.above); refreshTools(); });
  });

  function refreshCount() {
    countEl.textContent = `${notes.length} 个音符`;
    saveLocal();
  }

  /* ---------- 播放 ---------- */
  function sfx(freq: number) {
    if (!audioCtx) return;
    const t0 = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = "square";
    osc.frequency.value = freq;
    gain.gain.setValueAtTime(0.1, t0);
    gain.gain.exponentialRampToValueAtTime(0.001, t0 + 0.05);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(t0); osc.stop(t0 + 0.06);
  }

  function tick(ts: number) {
    if (!playing) return;
    if (!lastTs) lastTs = ts;
    const dt = (ts - lastTs) / 1000;
    lastTs = ts;
    const prev = playSec;
    playSec += dt;
    const prevBeat = secToBeat(prev);
    const nowBeat = secToBeat(playSec);
    for (const n of notes) {
      if (n.beat > prevBeat && n.beat <= nowBeat) {
        const freq = n.type === 1 ? 880 : n.type === 2 ? 660 : n.type === 3 ? 520 : 990;
        sfx(freq);
      }
    }
    if (nowBeat > viewStart + viewSpan * 0.9) {
      viewStart = Math.max(0, nowBeat - viewSpan * 0.2);
    }
    draw();
    drawLinePreview();
    raf = requestAnimationFrame(tick);
  }

  function startAudio(at: number) {
    if (!audioBuffer || !audioCtx) return;
    stopAudio();
    const src = audioCtx.createBufferSource();
    src.buffer = audioBuffer;
    src.connect(audioCtx.destination);
    try { src.start(0, clamp(at, 0, audioBuffer.duration)); } catch (_) { return; }
    audioSrc = src;
  }
  function stopAudio() {
    if (audioSrc) {
      try { audioSrc.stop(); } catch (_) { /* 忽略 */ }
      try { audioSrc.disconnect(); } catch (_) { /* 忽略 */ }
      audioSrc = null;
    }
  }

  function togglePlay() {
    if (playing) { pausePlay(); return; }
    if (!audioCtx) {
      const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (AC) audioCtx = new AC();
    }
    void audioCtx?.resume();
    // 从选中音符或视口起点开始
    playSec = Math.max(0, beatToSec(viewStart));
    playing = true;
    lastTs = 0;
    $("ce-play").textContent = "暂停";
    startAudio(playSec);
    raf = requestAnimationFrame(tick);
  }
  function pausePlay() {
    playing = false;
    if (raf) cancelAnimationFrame(raf);
    raf = 0;
    stopAudio();
    $("ce-play").textContent = "播放";
    draw();
  }
  function stopPlay() {
    pausePlay();
    playSec = 0;
    draw();
  }

  /* ---------- 判定线动画 ---------- */
  function evalLine(beat: number): LineKey {
    const ks = [...lineKeys].sort((a, b) => a.beat - b.beat);
    if (!ks.length) return { beat: 0, y: 0, rot: 0, alpha: 255 };
    if (beat <= ks[0].beat) return { ...ks[0] };
    for (let i = 1; i < ks.length; i++) {
      if (beat <= ks[i].beat) {
        const span = Math.max(1e-6, ks[i].beat - ks[i - 1].beat);
        const p = (beat - ks[i - 1].beat) / span;
        return {
          beat,
          y: ks[i - 1].y + (ks[i].y - ks[i - 1].y) * p,
          rot: ks[i - 1].rot + (ks[i].rot - ks[i - 1].rot) * p,
          alpha: ks[i - 1].alpha + (ks[i].alpha - ks[i - 1].alpha) * p,
        };
      }
    }
    return { ...ks[ks.length - 1] };
  }

  function sliderLine(): { y: number; rot: number; alpha: number } {
    const y = Number($<HTMLInputElement>("ce-line-y").value) || 0;
    const tl = Number($<HTMLInputElement>("ce-line-tl").value) || 0;
    const tr = Number($<HTMLInputElement>("ce-line-tr").value) || 0;
    const alpha = Number($<HTMLInputElement>("ce-line-alpha").value) || 255;
    return { y, rot: tr - tl, alpha };
  }
  function setSliders(y: number, rot: number, alpha: number) {
    $<HTMLInputElement>("ce-line-y").value = String(Math.round(clamp(y, -450, 450)));
    $<HTMLInputElement>("ce-line-tl").value = String(Math.round(clamp(-rot / 2, -90, 90)));
    $<HTMLInputElement>("ce-line-tr").value = String(Math.round(clamp(rot / 2, -90, 90)));
    $<HTMLInputElement>("ce-line-alpha").value = String(Math.round(clamp(alpha, 0, 255)));
    syncLineLabels();
  }
  function syncLineLabels() {
    $("ce-tl-val").textContent = $<HTMLInputElement>("ce-line-tl").value;
    $("ce-ly-val").textContent = $<HTMLInputElement>("ce-line-y").value;
    $("ce-tr-val").textContent = $<HTMLInputElement>("ce-line-tr").value;
    $("ce-la-val").textContent = $<HTMLInputElement>("ce-line-alpha").value;
  }

  function previewLineGeom() {
    const cv = $<HTMLCanvasElement>("ce-line-preview");
    const w = cv.clientWidth || 300;
    const h = 120;
    const st = playing ? evalLine(secToBeat(playSec)) : sliderLine();
    const cy = 10 + ((450 - clamp(st.y, -450, 450)) / 900) * (h - 20);
    const rad = (st.rot * Math.PI) / 180;
    const len = w * 0.84;
    const dx = (Math.cos(rad) * len) / 2;
    const dy = (Math.sin(rad) * len) / 2;
    return {
      w, h, st,
      x1: w / 2 - dx, y1: cy - dy,
      x2: w / 2 + dx, y2: cy + dy,
    };
  }

  function drawLinePreview() {
    const cv = $<HTMLCanvasElement>("ce-line-preview");
    if (!cv) return;
    const c = cv.getContext("2d");
    if (!c) return;
    const g = previewLineGeom();
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    cv.width = Math.round(g.w * dpr);
    cv.height = Math.round(g.h * dpr);
    c.setTransform(dpr, 0, 0, dpr, 0, 0);
    c.clearRect(0, 0, g.w, g.h);
    c.fillStyle = "#0f1115";
    c.fillRect(0, 0, g.w, g.h);

    c.globalAlpha = clamp(g.st.alpha / 255, 0, 1);
    c.strokeStyle = "#2dd4bf";
    c.lineWidth = 3;
    c.beginPath();
    c.moveTo(g.x1, g.y1);
    c.lineTo(g.x2, g.y2);
    c.stroke();
    c.fillStyle = "#2dd4bf";
    c.beginPath(); c.arc(g.x1, g.y1, 5, 0, Math.PI * 2); c.fill();
    c.beginPath(); c.arc(g.x2, g.y2, 5, 0, Math.PI * 2); c.fill();
    c.globalAlpha = 1;

    c.fillStyle = "#6b7280";
    c.font = "11px ui-monospace, monospace";
    const beat = playing || playSec > 0 ? secToBeat(playSec) : viewStart;
    c.fillText(`拍 ${beat.toFixed(2)} · Y ${Math.round(g.st.y)} · 旋转 ${Math.round(g.st.rot)}° · A ${Math.round(g.st.alpha)}`, 8, 14);
    c.fillText("拖两端改倾角 · 拖中间改上下", 8, g.h - 8);
  }

  // 预览画布上直接拖判定线
  let previewDrag: "y" | "l" | "r" | null = null;
  let previewLastY = 0;
  function bindLinePreviewDrag() {
    const cv = $<HTMLCanvasElement>("ce-line-preview");
    cv.addEventListener("pointerdown", (e) => {
      e.preventDefault();
      const rect = cv.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const g = previewLineGeom();
      const dL = Math.hypot(x - g.x1, y - g.y1);
      const dR = Math.hypot(x - g.x2, y - g.y2);
      previewDrag = dL < 26 ? "l" : dR < 26 ? "r" : "y";
      previewLastY = y;
      cv.setPointerCapture(e.pointerId);
    });
    cv.addEventListener("pointermove", (e) => {
      if (!previewDrag) return;
      const rect = cv.getBoundingClientRect();
      const y = e.clientY - rect.top;
      const dy = y - previewLastY;
      previewLastY = y;
      const scale = 900 / Math.max(20, rect.height - 20);
      if (previewDrag === "y") {
        const el = $<HTMLInputElement>("ce-line-y");
        el.value = String(Math.round(clamp(Number(el.value) - dy * scale, -450, 450)));
      } else if (previewDrag === "l") {
        const el = $<HTMLInputElement>("ce-line-tl");
        el.value = String(Math.round(clamp(Number(el.value) - dy * 0.9, -90, 90)));
      } else {
        const el = $<HTMLInputElement>("ce-line-tr");
        el.value = String(Math.round(clamp(Number(el.value) - dy * 0.9, -90, 90)));
      }
      syncLineLabels();
      drawLinePreview();
    });
    const stop = () => { previewDrag = null; };
    cv.addEventListener("pointerup", stop);
    cv.addEventListener("pointercancel", stop);
  }

  function renderLineKeys() {
    const box = $("ce-line-keys");
    if (!box) return;
    const ks = [...lineKeys].sort((a, b) => a.beat - b.beat);
    box.innerHTML = ks.map((k) =>
      `<div class="flex items-center gap-2 text-xs py-1 border-b border-(--line-divider)">
         <span class="font-mono w-16">${k.beat.toFixed(2)} 拍</span>
         <span class="font-mono flex-1">Y ${Math.round(k.y)} · ${Math.round(k.rot)}° · A ${Math.round(k.alpha)}</span>
         <button class="ce-key-del text-red-500 px-1" data-beat="${k.beat}">×</button>
       </div>`).join('') || '<div class="text-xs text-neutral-500">暂无关键帧</div>';
    box.querySelectorAll(".ce-key-del").forEach((el) => {
      el.addEventListener("click", () => {
        if (lineKeys.length <= 1) { setStatus("至少保留一个关键帧"); return; }
        const beat = Number((el as HTMLElement).dataset.beat);
        lineKeys = lineKeys.filter((k) => Math.abs(k.beat - beat) > 1e-6);
        renderLineKeys();
        drawLinePreview();
      });
    });
  }

  function addLineKey() {
    const beat = snapBeat(playing ? secToBeat(playSec) : viewStart + viewSpan / 2);
    const st = sliderLine();
    lineKeys = lineKeys.filter((k) => Math.abs(k.beat - beat) > 1e-6);
    lineKeys.push({ beat, y: clamp(st.y, -450, 450), rot: st.rot, alpha: clamp(st.alpha, 0, 255) });
    lineKeys.sort((a, b) => a.beat - b.beat);
    renderLineKeys();
    drawLinePreview();
    setStatus(`已加判定线关键帧：第 ${beat.toFixed(2)} 拍 · Y ${Math.round(st.y)} · ${Math.round(st.rot)}°`);
  }

  function buildEvents(get: (k: LineKey) => number): Record<string, unknown>[] {
    const ks = [...lineKeys].sort((a, b) => a.beat - b.beat);
    return ks.map((k, i) => {
      const next = ks[i + 1] || k;
      return {
        startTime: trip(k.beat),
        endTime: trip(next.beat),
        start: get(k),
        end: get(next),
        easingType: 1,
      };
    });
  }

  /* ---------- 导入 / 导出 ---------- */
  function buildRPE(): Record<string, unknown> {
    const sorted = [...notes].sort((a, b) => a.beat - b.beat);
    const maxBeat = sorted.reduce((m, n) => Math.max(m, n.endBeat), 0);
    return {
      BPMList: [{ bpm, startTime: [0, 0, 1] }],
      META: {
        RPEVersion: 150,
        offset: Math.round(offsetMs),
        name: $<HTMLInputElement>("ce-name").value.trim() || "未命名谱面",
        id: "0",
        song: "song.ogg",
        background: "background.png",
        composer: $<HTMLInputElement>("ce-composer").value.trim() || "",
        charter: $<HTMLInputElement>("ce-charter").value.trim() || "",
        level: $<HTMLInputElement>("ce-level").value.trim() || "",
      },
      chartTime: Math.round(beatToSec(maxBeat) * 1000) / 1000,
      judgeLineGroup: ["line"],
      judgeLineList: [{
        Name: "line",
        Texture: "line.png",
        father: -1,
        isCover: 1,
        zOrder: 0,
        numOfNotes: sorted.length,
        notes: sorted.map((n) => ({
          type: n.type,
          startTime: trip(n.beat),
          endTime: trip(n.type === 3 ? n.endBeat : n.beat),
          positionX: n.x,
          above: n.above ? 1 : 0,
          isFake: false,
          speed: 1,
          size: 1,
          alpha: 255,
        })),
        eventLayers: [{
          speedEvents: [{ startTime: [0, 0, 1], endTime: [0, 0, 1], start: 1, end: 1 }],
          moveXEvents: [{ startTime: [0, 0, 1], endTime: [0, 0, 1], start: 0, end: 0 }],
          moveYEvents: buildEvents((k) => k.y),
          rotateEvents: buildEvents((k) => k.rot),
          alphaEvents: buildEvents((k) => k.alpha),
        }],
      }],
    };
  }

  function exportJSON() {
    if (!notes.length) { setStatus("还没有音符，先点画布加几个"); return; }
    const blob = new Blob([JSON.stringify(buildRPE(), null, 2)], { type: "application/json" });
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    const base = ($<HTMLInputElement>("ce-name").value.trim() || "chart").replace(/[\\/:*?"<>|]/g, "_");
    a.download = base + ".json";
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    setStatus(`已导出 ${notes.length} 个音符`);
  }

  function importJSON(data: Record<string, unknown>) {
    const lines = Array.isArray(data.judgeLineList) ? data.judgeLineList as Record<string, unknown>[] : [];
    const line = lines[0];
    if (!line || !Array.isArray(line.notes)) { setStatus("没找到 judgeLineList / notes"); return; }
    const out: Note[] = [];
    for (const raw of line.notes as Record<string, unknown>[]) {
      const start = parseTrip(raw.startTime);
      if (start === null) continue;
      const end = parseTrip(raw.endTime);
      out.push({
        type: Number(raw.type) || 1,
        beat: start,
        endBeat: end !== null && end > start ? end : start,
        x: Number(raw.positionX) || 0,
        above: Number(raw.above) === 0 ? 0 : 1,
      });
    }
    notes = out;
    const meta = (data.META || {}) as Record<string, unknown>;
    const bpmList = Array.isArray(data.BPMList) ? data.BPMList as Record<string, unknown>[] : [];
    if (bpmList.length) {
      const b = Number(bpmList[0].bpm);
      if (b > 0) { bpm = b; $<HTMLInputElement>("ce-bpm").value = String(b); }
    }
    if (typeof meta.offset === "number") { offsetMs = meta.offset; $<HTMLInputElement>("ce-offset").value = String(meta.offset); }
    if (typeof meta.name === "string") $<HTMLInputElement>("ce-name").value = meta.name;
    if (typeof meta.composer === "string") $<HTMLInputElement>("ce-composer").value = meta.composer;
    if (typeof meta.charter === "string") $<HTMLInputElement>("ce-charter").value = meta.charter;
    if (typeof meta.level === "string") $<HTMLInputElement>("ce-level").value = meta.level;
    // 判定线事件 → 关键帧
    const layers = Array.isArray(line.eventLayers) ? line.eventLayers as Record<string, unknown>[] : [];
    const layer = layers[0];
    if (layer) {
      const map = new Map<number, LineKey>();
      const readEv = (name: string, set: (k: LineKey, v: number) => void) => {
        const arr = Array.isArray(layer[name]) ? layer[name] as Record<string, unknown>[] : [];
        for (const ev of arr) {
          const b = parseTrip(ev.startTime);
          if (b === null) continue;
          const key = Math.round(b * 1000) / 1000;
          const cur = map.get(key) || { beat: b, y: 0, rot: 0, alpha: 255 };
          set(cur, Number(ev.start) || 0);
          map.set(key, cur);
        }
      };
      readEv("moveYEvents", (k, v) => { k.y = v; });
      readEv("rotateEvents", (k, v) => { k.rot = v; });
      readEv("alphaEvents", (k, v) => { k.alpha = v === 0 ? 255 : v; });
      if (map.size) {
        lineKeys = [...map.values()].sort((a, b) => a.beat - b.beat);
        renderLineKeys();
        setSliders(lineKeys[0].y, lineKeys[0].rot, lineKeys[0].alpha);
        drawLinePreview();
      }
    }

    selected = -1;
    refreshCount();
    draw();
    setStatus(`已导入 ${notes.length} 个音符`);
  }

  /* ---------- 本地保存 ---------- */
  const LS_KEY = "firefly-chart-editor-v1";
  function saveLocal() {
    try {
      localStorage.setItem(LS_KEY, JSON.stringify({ notes, bpm, offsetMs, name: $<HTMLInputElement>("ce-name").value }));
    } catch (_) { /* 忽略 */ }
  }
  function loadLocal() {
    try {
      const raw = localStorage.getItem(LS_KEY);
      if (!raw) return;
      const d = JSON.parse(raw) as { notes?: Note[]; bpm?: number; offsetMs?: number; name?: string };
      if (Array.isArray(d.notes)) notes = d.notes;
      if (d.bpm) { bpm = d.bpm; $<HTMLInputElement>("ce-bpm").value = String(d.bpm); }
      if (typeof d.offsetMs === "number") { offsetMs = d.offsetMs; $<HTMLInputElement>("ce-offset").value = String(d.offsetMs); }
      if (d.name) $<HTMLInputElement>("ce-name").value = d.name;
      setStatus("已恢复上次编辑的内容");
    } catch (_) { /* 忽略 */ }
  }

  /* ---------- 绑定 ---------- */
  $("ce-play").addEventListener("click", togglePlay);
  $("ce-stop").addEventListener("click", stopPlay);
  $("ce-export").addEventListener("click", exportJSON);
  $("ce-clear").addEventListener("click", () => {
    if (!notes.length) return;
    if (!confirm(`确定清空 ${notes.length} 个音符？`)) return;
    notes = []; selected = -1; refreshCount(); draw(); setStatus("已清空");
  });
  $("ce-new").addEventListener("click", () => {
    if (notes.length && !confirm("新建会清空当前音符，继续？")) return;
    if (playing) pausePlay();
    notes = [];
    selected = -1;
    playSec = 0;
    viewStart = 0;
    viewSpan = 16;
    lineKeys = [{ beat: 0, y: 0, rot: 0, alpha: 255 }];
    $<HTMLInputElement>("ce-name").value = "";
    $<HTMLInputElement>("ce-level").value = "";
    refreshCount();
    renderLineKeys();
    setSliders(0, 0, 255);
    draw();
    drawLinePreview();
    setStatus("已新建空白谱面");
  });
  $("ce-del").addEventListener("click", () => {
    if (!sel.size) { setStatus("先框选或点选音符"); return; }
    for (const i of [...sel].sort((a, b) => b - a)) notes.splice(i, 1);
    sel.clear();
    selected = -1;
    refreshCount();
    draw();
    setStatus("已删除选中音符");
  });
  $("ce-import").addEventListener("click", () => $<HTMLInputElement>("ce-import-file").click());
  $<HTMLInputElement>("ce-import-file").addEventListener("change", async (e) => {
    const input = e.target as HTMLInputElement;
    const f = input.files?.[0];
    if (!f) return;
    try {
      importJSON(JSON.parse(await f.text()) as Record<string, unknown>);
    } catch (err) {
      setStatus(`导入失败：${err instanceof Error ? err.message : String(err)}`);
    }
    input.value = "";
  });
  $("ce-audio").addEventListener("click", () => $<HTMLInputElement>("ce-audio-file").click());
  $<HTMLInputElement>("ce-audio-file").addEventListener("change", async (e) => {
    const input = e.target as HTMLInputElement;
    const f = input.files?.[0];
    if (!f) return;
    try {
      if (!audioCtx) {
        const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (AC) audioCtx = new AC();
      }
      if (!audioCtx) { setStatus("当前浏览器不支持音频"); return; }
      setStatus("正在解码音频…");
      audioBuffer = await audioCtx.decodeAudioData(await f.arrayBuffer());
      setStatus(`音频已载入：${f.name}`);
    } catch (err) {
      setStatus(`音频解码失败：${err instanceof Error ? err.message : String(err)}`);
    }
    input.value = "";
  });
  $<HTMLInputElement>("ce-bpm").addEventListener("change", () => {
    bpm = Math.max(1, Number($<HTMLInputElement>("ce-bpm").value) || 120);
    saveLocal(); draw();
  });
  $<HTMLInputElement>("ce-offset").addEventListener("change", () => {
    offsetMs = Number($<HTMLInputElement>("ce-offset").value) || 0;
    saveLocal();
  });
  $<HTMLSelectElement>("ce-snap").addEventListener("change", () => {
    snap = Number($<HTMLSelectElement>("ce-snap").value) || 0.25;
  });
  $<HTMLInputElement>("ce-hold").addEventListener("change", () => {
    holdLen = Math.max(0.125, Number($<HTMLInputElement>("ce-hold").value) || 1);
  });
  $("ce-zoom-in").addEventListener("click", () => { viewSpan = clamp(viewSpan * 0.75, 2, 128); draw(); });
  $("ce-zoom-out").addEventListener("click", () => { viewSpan = clamp(viewSpan * 1.33, 2, 128); draw(); });
  $("ce-fit").addEventListener("click", () => {
    const maxBeat = notes.reduce((m, n) => Math.max(m, n.endBeat), 16);
    viewStart = 0; viewSpan = Math.max(8, maxBeat * 1.1); draw();
  });
  window.addEventListener("resize", () => { draw(); drawLinePreview(); });

  // 判定线关键帧
  $("ce-line-add").addEventListener("click", addLineKey);
  ["ce-line-tl", "ce-line-y", "ce-line-tr", "ce-line-alpha"].forEach((id) => {
    $<HTMLInputElement>(id).addEventListener("input", () => {
      syncLineLabels();
      drawLinePreview();
    });
  });
  bindLinePreviewDrag();

  // 拖拽文件导入
  let dragDepth = 0;
  const showDrop = () => $("ce-drop-hint").classList.remove("hidden");
  const hideDrop = () => $("ce-drop-hint").classList.add("hidden");
  window.addEventListener("dragenter", (e) => { e.preventDefault(); dragDepth++; showDrop(); });
  window.addEventListener("dragover", (e) => e.preventDefault());
  window.addEventListener("dragleave", (e) => {
    e.preventDefault();
    dragDepth = Math.max(0, dragDepth - 1);
    if (!dragDepth) hideDrop();
  });
  window.addEventListener("drop", async (e) => {
    e.preventDefault();
    dragDepth = 0;
    hideDrop();
    const f = e.dataTransfer?.files?.[0];
    if (!f) return;
    if (/\.json$/i.test(f.name)) {
      try {
        importJSON(JSON.parse(await f.text()) as Record<string, unknown>);
      } catch (err) {
        setStatus(`导入失败：${err instanceof Error ? err.message : String(err)}`);
      }
    } else if (/^audio\//.test(f.type) || /\.(mp3|ogg|wav|m4a|flac)$/i.test(f.name)) {
      try {
        if (!audioCtx) {
          const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
          if (AC) audioCtx = new AC();
        }
        if (!audioCtx) { setStatus("当前浏览器不支持音频"); return; }
        setStatus("正在解码音频…");
        audioBuffer = await audioCtx.decodeAudioData(await f.arrayBuffer());
        setStatus(`音频已载入：${f.name}`);
      } catch (err) {
        setStatus(`音频解码失败：${err instanceof Error ? err.message : String(err)}`);
      }
    } else {
      setStatus("只支持拖入谱面 .json 或音频文件");
    }
  });

  /* ---------- 初始化 ---------- */
  refreshTools();
  loadLocal();
  refreshCount();
  renderLineKeys();
  syncLineLabels();
  draw();
  drawLinePreview();
</script>
