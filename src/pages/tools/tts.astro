  // ==================== 下载逻辑 ====================
  async function downloadTrack(id) {
    const t = tracks.find(tr => tr.id === id);
    if (!t || !t.text.trim()) { showToast('请输入文本', 'warn'); return; }
    const el = document.getElementById(`track-${id}`);
    const status = el.querySelector('.track-status');
    status.textContent = '下载中...';

    try {
      let blob;
      if (t.source === 'edge') {
        blob = await edgeTTS.synthesize(t.text, t.params.edgeVoice, t.params.edgeStyle, t.params.edgeRate, t.params.edgePitch);
      } else if (t.source === 'openai') {
        const cfg = getApiConfig();
        const resp = await fetch('https://api.openai.com/v1/audio/speech', {
          method: 'POST',
          headers: { 'Authorization': 'Bearer ' + cfg['openai-key'], 'Content-Type': 'application/json' },
          body: JSON.stringify({ model: 'tts-1', input: t.text, voice: t.params.oaVoice, speed: t.params.oaSpeed })
        });
        blob = await resp.blob();
      } else if (t.source === 'azure') {
        const cfg = getApiConfig();
        const ssml = `<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xmlns:mstts="https://www.w3.org/2001/mstts" xml:lang="zh-CN"><voice name="${t.params.azVoice}"><mstts:express-as style="${t.params.azStyle}">${t.text}</mstts:express-as></voice></speak>`;
        const resp = await fetch(`https://${cfg['azure-region']}.tts.speech.microsoft.com/cognitiveservices/v1`, {
          method: 'POST',
          headers: { 'Ocp-Apim-Subscription-Key': cfg['azure-key'], 'Content-Type': 'application/ssml+xml', 'X-Microsoft-OutputFormat': 'audio-16khz-128kbitrate-mono-mp3' },
          body: ssml
        });
        blob = await resp.blob();
      } else if (t.source === 'localapi') {
        const cfg = getApiConfig();
        let extra = {}; try { extra = JSON.parse(t.params.lapiParams || '{}'); } catch(e) {}
        const resp = await fetch(cfg['local-api-url'], {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: t.text, voice: t.params.lapiVoice, rate: t.params.lapiRate, ...extra })
        });
        blob = await resp.blob();
      } else if (t.source === 'aliyun') {
        showToast('阿里云下载需要后端代理，建议用Edge或OpenAI', 'warn');
        status.textContent = '就绪';
        return;
      } else {
        showToast('本地浏览器不支持直接下载音频文件', 'warn');
        status.textContent = '就绪';
        return;
      }

      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `tts-track-${t.id}-${Date.now()}.mp3`;
      a.click();
      URL.revokeObjectURL(url);
      status.textContent = '下载完成';
      showToast('下载完成', 'success');
    } catch (err) {
      status.textContent = '失败';
      showToast(err.message || '下载失败', 'error');
    }
  }

  // ==================== 合并导出 ====================
  async function mergeAndDownload() {
    if (!tracks.length) { showToast('没有音轨可合并', 'warn'); return; }
    const validTracks = tracks.filter(t => t.text.trim());
    if (!validTracks.length) { showToast('音轨文本为空', 'warn'); return; }

    showToast('开始合成所有音轨...', 'info');
    const blobs = [];

    for (const t of validTracks) {
      try {
        let blob;
        if (t.source === 'edge') {
          blob = await edgeTTS.synthesize(t.text, t.params.edgeVoice, t.params.edgeStyle, t.params.edgeRate, t.params.edgePitch);
        } else if (t.source === 'openai') {
          const cfg = getApiConfig();
          const resp = await fetch('https://api.openai.com/v1/audio/speech', {
            method: 'POST',
            headers: { 'Authorization': 'Bearer ' + cfg['openai-key'], 'Content-Type': 'application/json' },
            body: JSON.stringify({ model: 'tts-1', input: t.text, voice: t.params.oaVoice, speed: t.params.oaSpeed })
          });
          blob = await resp.blob();
        } else if (t.source === 'azure') {
          const cfg = getApiConfig();
          const ssml = `<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xmlns:mstts="https://www.w3.org/2001/mstts" xml:lang="zh-CN"><voice name="${t.params.azVoice}"><mstts:express-as style="${t.params.azStyle}">${t.text}</mstts:express-as></voice></speak>`;
          const resp = await fetch(`https://${cfg['azure-region']}.tts.speech.microsoft.com/cognitiveservices/v1`, {
            method: 'POST',
            headers: { 'Ocp-Apim-Subscription-Key': cfg['azure-key'], 'Content-Type': 'application/ssml+xml', 'X-Microsoft-OutputFormat': 'audio-16khz-128kbitrate-mono-mp3' },
            body: ssml
          });
          blob = await resp.blob();
        } else if (t.source === 'localapi') {
          const cfg = getApiConfig();
          let extra = {}; try { extra = JSON.parse(t.params.lapiParams || '{}'); } catch(e) {}
          const resp = await fetch(cfg['local-api-url'], {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text: t.text, voice: t.params.lapiVoice, rate: t.params.lapiRate, ...extra })
          });
          blob = await resp.blob();
        } else {
          continue; // 跳过本地浏览器和阿里云
        }
        blobs.push(blob);
      } catch (e) {
        showToast(`音轨 #${t.id} 合成失败: ${e.message}`, 'error');
      }
    }

    if (!blobs.length) { showToast('没有可合并的音频', 'error'); return; }

    // 使用Web Audio API合并
    showToast('合并音频中...', 'info');
    try {
      const ctx = new AudioContext();
      const buffers = [];
      for (const blob of blobs) {
        const arr = await blob.arrayBuffer();
        const buf = await ctx.decodeAudioData(arr);
        buffers.push(buf);
      }

      // 计算总长度
      let totalSamples = 0;
      buffers.forEach(b => totalSamples += b.length);
      const out = ctx.createBuffer(2, totalSamples, ctx.sampleRate); // 立体声

      let offset = 0;
      buffers.forEach(buf => {
        // 混音到立体声
        for (let ch = 0; ch < 2; ch++) {
          const srcCh = buf.numberOfChannels > ch ? ch : 0;
          out.getChannelData(ch).set(buf.getChannelData(srcCh), offset);
        }
        offset += buf.length;
      });

      // 导出WAV
      const wavBlob = bufferToWave(out, totalSamples);
      const url = URL.createObjectURL(wavBlob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `tts-merged-${Date.now()}.wav`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('合并导出完成！', 'success');
    } catch (e) {
      showToast('合并失败: ' + e.message, 'error');
    }
  }

  // AudioBuffer转WAV
  function bufferToWave(abuffer, len) {
    let numOfChan = abuffer.numberOfChannels, length = len * numOfChan * 2 + 44,
        buffer = new ArrayBuffer(length), view = new DataView(buffer),
        channels = [], i, sample, offset = 0, pos = 0;
    // 写入WAV头部
    setUint32(0x46464952); // "RIFF"
    setUint32(length - 8); // file length
    setUint32(0x45564157); // "WAVE"
    setUint32(0x20746d66); // "fmt " chunk
    setUint32(16); // length = 16
    setUint16(1); // PCM
    setUint16(numOfChan);
    setUint32(abuffer.sampleRate);
    setUint32(abuffer.sampleRate * 2 * numOfChan); // avg. bytes/sec
    setUint16(numOfChan * 2); // block-align
    setUint16(16); // 16-bit
    setUint32(0x61746164); // "data" chunk
    setUint32(length - pos - 4); // chunk length

    for(i = 0; i < abuffer.numberOfChannels; i++) channels.push(abuffer.getChannelData(i));
    while(pos < length) {
      for(i = 0; i < numOfChan; i++) {
        sample = Math.max(-1, Math.min(1, channels[i][offset])); 
        sample = (0.5 + sample < 0 ? sample * 32768 : sample * 32767)|0;
        view.setInt16(pos, sample, true); pos += 2;
      }
      offset++;
    }
    return new Blob([buffer], { type: 'audio/wav' });
    function setUint16(data) { view.setUint16(pos, data, true); pos += 2; }
    function setUint32(data) { view.setUint32(pos, data, true); pos += 4; }
  }

  // ==================== 顺序播放 ====================
  async function playAll() {
    if (!tracks.length) { showToast('没有音轨', 'warn'); return; }
    stopAll();
    isPlaying = true;
    document.getElementById('btn-stop').classList.remove('hidden');

    for (const t of tracks) {
      if (!isPlaying) break;
      if (!t.text.trim()) continue;
      await playTrack(t.id);
      // 等待播放结束
      await new Promise(r => {
        const check = setInterval(() => {
          if (!isPlaying || !currentAudio || currentAudio.ended || currentAudio.paused) {
            clearInterval(check);
            r();
          }
        }, 200);
      });
      await new Promise(r => setTimeout(r, 300)); // 段落间隔
    }

    isPlaying = false;
    document.getElementById('btn-stop').classList.add('hidden');
  }

  // ==================== UI状态更新 ====================
  function updateEmptyState() {
    const empty = document.getElementById('empty-state');
    if (tracks.length === 0) empty.classList.remove('hidden');
    else empty.classList.add('hidden');
  }

  function updateGlobalStatus() {
    const valid = tracks.filter(t => t.text.trim()).length;
    document.getElementById('global-status').textContent = `就绪 · ${tracks.length} 个音轨 · ${valid} 段有文本`;
  }

  // ==================== 事件绑定 ====================
  document.addEventListener('DOMContentLoaded', () => {
    loadApiConfig();

    // API配置面板
    document.getElementById('btn-api-config').addEventListener('click', () => {
      const panel = document.getElementById('api-config-panel');
      panel.classList.toggle('hidden');
    });
    document.getElementById('btn-save-api').addEventListener('click', saveApiConfig);
    document.getElementById('btn-clear-api').addEventListener('click', clearApiConfig);

    // 全局控制
    document.getElementById('btn-add-track').addEventListener('click', () => addTrack());
    document.getElementById('btn-play-all').addEventListener('click', playAll);
    document.getElementById('btn-merge').addEventListener('click', mergeAndDownload);
    document.getElementById('btn-stop').addEventListener('click', stopAll);

    // 监听voices变化
    speechSynthesis.onvoiceschanged = () => {
      document.querySelectorAll('[data-param="voice"]').forEach(sel => {
        const trackId = parseInt(sel.closest('[id^="track-"]').id.replace('track-',''));
        const t = tracks.find(tr => tr.id === trackId);
        if (t) loadLocalVoices(sel, t.params.voice);
      });
    };

    // 初始添加一个音轨
    addTrack();
  });
