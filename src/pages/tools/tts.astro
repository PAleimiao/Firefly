---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---<!-- Tab 标签栏 -->
<div class="tts-tabs">
  <div class="tts-tab active" data-tab="basic"><i class="fas fa-microphone"></i> 基础</div>
  <div class="tts-tab" data-tab="timbre"><i class="fas fa-magic"></i> 音色</div>
  <div class="tts-tab" data-tab="track"><i class="fas fa-sliders-h"></i> 音轨</div>
  <div class="tts-tab" data-tab="studio"><i class="fas fa-wave-square"></i> 工作室</div>
</div>

<!-- 基础面板 -->
<div class="tts-tab-panel active" id="tab-basic">
  <div class="tts-card">
    <h3 class="tts-card-title"><i class="fas fa-microphone"></i> 本地合成</h3>
{ Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="语音合成" description="本地文字转语音与录音特征模仿工具">
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="flex items-center gap-3 mb-3">
        <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
          <Icon is:inline name="material-symbols:record-voice-over" class="text-[1.5rem]"></Icon>
        </div>
        <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">语音合成</div>
      </div>
      <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
        输入文字即可朗读；还可以上传一段真人录音，在本地提取它的音高与语速特征，让合成声音模仿 Ta 的说话感觉。追求更高音质？页底可接入你自己的 OpenAI / 阿里云语音 API。
      </p>

      <!-- 本地算力提示 -->
      <div class="rounded-xl border border-amber-500/40 bg-amber-500/10 px-4 py-3 mb-6 text-sm text-amber-700 dark:text-amber-300 leading-relaxed">
        ⚠️ 本工具的合成与分析<b>全程在你的设备本地完成，不经过任何云端服务器</b>。生成与朗读可能占用本地算力，<b>设备出现卡顿、发热均属正常现象</b>，长文本请耐心等待。
      </div>

      <div id="tts-unsupported" class="hidden rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 mb-6 text-sm text-red-600 dark:text-red-300">
        当前浏览器不支持本地语音合成（Web Speech API），请换用最新版 Chrome / Edge / Safari 试试。
      </div>

      <!-- 文本输入 -->
      <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2">要朗读的文字</label>
      <textarea id="tts-text" rows="5" maxlength="2000" placeholder="在这里输入要合成语音的文字……"
        class="w-full rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-3 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary) transition mb-4"></textarea>

      <!-- 声音选择 -->
      <label class="block text-sm font-medium text-neutral-700 dark:text-neutral-300 mb-2">声音（来自你设备的本地语音库）</label>
      <select id="tts-voice" class="w-full rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-3 text-neutral-900 dark:text-neutral-100 mb-4"></select>

      <!-- 参数滑块 -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-5">
        <div>
          <div class="flex justify-between text-sm text-neutral-700 dark:text-neutral-300 mb-1">
            <span>语速</span><span id="tts-rate-val">1.0</span>
          </div>
          <input id="tts-rate" type="range" min="0.5" max="2" step="0.1" value="1" class="w-full" />
        </div>
        <div>
          <div class="flex justify-between text-sm text-neutral-700 dark:text-neutral-300 mb-1">
            <span>音高</span><span id="tts-pitch-val">1.0</span>
          </div>
          <input id="tts-pitch" type="range" min="0.5" max="2" step="0.1" value="1" class="w-full" />
        </div>
        <div>
          <div class="flex justify-between text-sm text-neutral-700 dark:text-neutral-300 mb-1">
            <span>音量</span><span id="tts-volume-val">1.0</span>
          </div>
          <input id="tts-volume" type="range" min="0" max="1" step="0.1" value="1" class="w-full" />
        </div>
      </div>

      <!-- 播放控制 -->
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <button id="tts-speak" class="px-5 py-2.5 rounded-xl bg-(--primary) text-white dark:text-black/70 font-medium hover:opacity-85 active:scale-95 transition">▶ 开始朗读</button>
        <button id="tts-stop" class="px-5 py-2.5 rounded-xl bg-(--btn-regular-bg) text-(--btn-content) font-medium hover:opacity-85 active:scale-95 transition border border-(--line-divider)">■ 停止</button>
        <span id="tts-status" class="text-sm text-neutral-500 dark:text-neutral-400"></span>
      </div>
  </div>
</div>

<!-- 音色面板 -->
<div class="tts-tab-panel" id="tab-timbre">
<!-- 音色增强 -->
<div class="tts-card">
  <h3 class="tts-card-title"><i class="fas fa-magic"></i> 音色增强</h3>
  <div class="tts-row">
    <label class="tts-label" style="min-width:4.5em">音色预设</label>
    <select id="tts-timbre" class="tts-input">
      <option value="normal">原声</option>
      <option value="warm">温暖磁性 (+低频)</option>
      <option value="bright">明亮清脆 (+高频)</option>
      <option value="radio">电台腔 (加混响)</option>
      <option value="phone">电话音 (窄带)</option>
      <option value="robot">机械音 (失真)</option>
    </select>
  </div>
  <div class="tts-row">
    <label class="tts-label" style="min-width:4.5em">混响强度</label>
    <input id="tts-reverb" type="range" min="0" max="100" value="0" class="tts-slider">
    <span id="tts-reverb-val" class="tts-val">0%</span>
  </div>
  <div class="tts-row">
    <label class="tts-label" style="min-width:4.5em">EQ 低频</label>
    <input id="tts-eq-low" type="range" min="-12" max="12" value="0" class="tts-slider">
    <span id="tts-eq-low-val" class="tts-val">0dB</span>
  </div>
  <div class="tts-row">
    <label class="tts-label" style="min-width:4.5em">EQ 中频</label>
    <input id="tts-eq-mid" type="range" min="-12" max="12" value="0" class="tts-slider">
    <span id="tts-eq-mid-val" class="tts-val">0dB</span>
  </div>
  <div class="tts-row">
    <label class="tts-label" style="min-width:4.5em">EQ 高频</label>
    <input id="tts-eq-high" type="range" min="-12" max="12" value="0" class="tts-slider">
    <span id="tts-eq-high-val" class="tts-val">0dB</span>
  </div>
</div>


</div>

<!-- 音轨面板 -->
<div class="tts-tab-panel" id="tab-track">
<!-- 音轨控制 -->
<div class="tts-card">
  <h3 class="tts-card-title"><i class="fas fa-sliders-h"></i> 音轨控制</h3>
  <div class="tts-row">
    <label class="tts-label" style="min-width:4.5em">背景音</label>
    <input id="tts-bgm-file" type="file" accept="audio/*" class="tts-input" style="flex:1;font-size:0.75rem">
  </div>
  <div class="tts-row">
    <label class="tts-label" style="min-width:4.5em">BGM音量</label>
    <input id="tts-bgm-vol" type="range" min="0" max="100" value="30" class="tts-slider">
    <span id="tts-bgm-vol-val" class="tts-val">30%</span>
  </div>
  <div class="tts-row">
    <label class="tts-label" style="min-width:4.5em">声像平衡</label>
    <input id="tts-pan" type="range" min="-100" max="100" value="0" class="tts-slider">
    <span id="tts-pan-val" class="tts-val">C</span>
  </div>
  <div class="tts-row">
    <label class="tts-label" style="min-width:4.5em">淡入淡出</label>
    <select id="tts-fade" class="tts-input">
      <option value="none">无</option>
      <option value="in">淡入</option>
      <option value="out">淡出</option>
      <option value="both">淡入+淡出</option>
    </select>
  </div>
</div>


</div>

<!-- 工作室面板 -->
<div class="tts-tab-panel" id="tab-studio">
<!-- 音频工作室 -->
<div class="tts-card">
  <h3 class="tts-card-title"><i class="fas fa-wave-square"></i> 音频工作室</h3>
  <div class="tts-tip" style="margin-bottom:0.5rem">
    <i class="fas fa-info-circle"></i> 
    由于浏览器安全限制，Web Speech API 输出无法直接后处理。建议：先用上方 TTS 下载音频，再在此上传进行 EQ/混响/BGM 混合处理。
  </div>
  <div class="tts-row">
    <label class="tts-label" style="min-width:4.5em">上传音频</label>
    <input id="tts-studio-file" type="file" accept="audio/*" class="tts-input" style="flex:1;font-size:0.75rem">
  </div>
  <div class="tts-row" style="margin-top:0.5rem">
    <button id="tts-studio-process" class="tts-btn tts-btn-secondary" style="flex:1">
      <i class="fas fa-cogs"></i> 应用效果
    </button>
    <button id="tts-studio-export" class="tts-btn tts-btn-primary" style="flex:1;margin-left:0.5rem" disabled>
      <i class="fas fa-download"></i> 导出成品
    </button>
  </div>
  <div id="tts-studio-player-wrap" style="display:none;margin-top:0.5rem">
    <audio id="tts-studio-player" controls style="width:100%"></audio>
  </div>
</div>

<!-- 录音特征模仿 -->
      <div class="flex items-center gap-2 mb-2">
        <Icon is:inline name="material-symbols:graphic-eq" class="text-[1.25rem] text-(--primary)"></Icon>
        <div class="text-xl font-bold text-neutral-900 dark:text-neutral-100">录音特征模仿</div>
      </div>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-3">
        上传一段真人录音（建议 5–20 秒、尽量干净的人声），工具会在本地分析其<b>平均音高</b>与<b>语速</b>，并可一键套用到上方的合成参数。
      </p>
      <div class="rounded-xl border border-sky-500/40 bg-sky-500/10 px-4 py-3 mb-4 text-xs text-sky-700 dark:text-sky-300 leading-relaxed">
        说明：纯浏览器环境无法运行真正的 AI 音色克隆（那需要大型模型和 GPU 云端算力）。这里是提取录音的音高 / 语速特征进行模仿，让朗读更接近 Ta 的说话节奏，<b>音色本身仍取决于你设备上的语音库</b>。录音只在你本地分析，不会上传。
      </div>

      <div class="flex flex-wrap items-center gap-3 mb-4">
        <label class="px-5 py-2.5 rounded-xl bg-(--btn-regular-bg) text-(--btn-content) font-medium border border-(--line-divider) cursor-pointer hover:opacity-85 transition">
          选择录音文件
          <input id="tts-audio" type="file" accept="audio/*" class="hidden" />
        </label>
        <span id="tts-audio-name" class="text-sm text-neutral-500 dark:text-neutral-400 truncate max-w-full">未选择文件</span>
      </div>

      <div id="tts-analysis" class="hidden rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-3 mb-4 text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed"></div>

      <button id="tts-apply" class="hidden px-5 py-2.5 rounded-xl bg-(--primary) text-white dark:text-black/70 font-medium hover:opacity-85 active:scale-95 transition">✨ 应用此说话特征</button>

      <hr class="my-6 border-(--line-divider)" />

      <!-- 自备云端 API -->
      <div class="flex items-center gap-2 mb-2">
        <Icon is:inline name="material-symbols:cloud" class="text-[1.25rem] text-(--primary)"></Icon>
        <div class="text-xl font-bold text-neutral-900 dark:text-neutral-100">自备云端 API（进阶）</div>
      </div>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-3">
        对本地合成效果不满意？可以填入<b>你自己</b>的 OpenAI 或阿里云语音服务密钥，直接调用云端高质量合成，生成的音频还能下载。
      </p>
      <div class="rounded-xl border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 mb-4 text-xs text-emerald-700 dark:text-emerald-300 leading-relaxed">
        🔒 密钥只保存在<b>你自己的浏览器</b>里（localStorage），本站服务器看不到、收不到、也不存储；费用由你的账号自行承担。在别人的设备上用完记得点「清除已存密钥」。
      </div>

      <!-- 服务商切换 -->
      <div class="flex gap-2 mb-4">
        <button data-provider="openai" class="cloud-tab px-4 py-2 rounded-xl font-medium border border-(--line-divider) transition">OpenAI TTS</button>
        <button data-provider="aliyun" class="cloud-tab px-4 py-2 rounded-xl font-medium border border-(--line-divider) transition">阿里云语音合成</button>
      </div>

      <!-- OpenAI 配置 -->
      <div id="cloud-openai" class="hidden flex-col gap-3 mb-4">
        <div>
          <label class="block text-sm text-neutral-700 dark:text-neutral-300 mb-1">API Key</label>
          <input id="oai-key" type="password" placeholder="sk-..." autocomplete="off"
            class="w-full rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-2.5 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary) transition" />
        </div>
        <div>
          <label class="block text-sm text-neutral-700 dark:text-neutral-300 mb-1">接口地址（默认官方，可填中转站）</label>
          <input id="oai-base" type="text" placeholder="https://api.openai.com/v1" autocomplete="off"
            class="w-full rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-2.5 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary) transition" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-sm text-neutral-700 dark:text-neutral-300 mb-1">模型</label>
            <select id="oai-model" class="w-full rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-2.5 text-neutral-900 dark:text-neutral-100">
              <option value="gpt-4o-mini-tts">gpt-4o-mini-tts（便宜）</option>
              <option value="tts-1">tts-1</option>
              <option value="tts-1-hd">tts-1-hd（高音质）</option>
            </select>
          </div>
          <div>
            <label class="block text-sm text-neutral-700 dark:text-neutral-300 mb-1">音色</label>
            <select id="oai-voice" class="w-full rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-2.5 text-neutral-900 dark:text-neutral-100">
              <option value="alloy">alloy</option>
              <option value="ash">ash</option>
              <option value="ballad">ballad</option>
              <option value="coral">coral</option>
              <option value="echo">echo</option>
              <option value="fable">fable</option>
              <option value="nova">nova</option>
              <option value="onyx">onyx</option>
              <option value="sage">sage</option>
              <option value="shimmer">shimmer</option>
              <option value="verse">verse</option>
            </select>
          </div>
        </div>
      </div>

      <!-- 阿里云配置 -->
      <div id="cloud-aliyun" class="hidden flex-col gap-3 mb-4">
        <div>
          <label class="block text-sm text-neutral-700 dark:text-neutral-300 mb-1">AppKey（智能语音交互项目）</label>
          <input id="ali-appkey" type="text" placeholder="在阿里云控制台「智能语音交互 → 全部项目」里查看" autocomplete="off"
            class="w-full rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-2.5 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary) transition" />
        </div>
        <div>
          <label class="block text-sm text-neutral-700 dark:text-neutral-300 mb-1">访问 Token（24 小时有效，过期需重新获取）</label>
          <input id="ali-token" type="password" placeholder="通过 CreateToken 接口或控制台获取" autocomplete="off"
            class="w-full rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-2.5 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary) transition" />
        </div>
        <div>
          <label class="block text-sm text-neutral-700 dark:text-neutral-300 mb-1">音色</label>
          <select id="ali-voice" class="w-full rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-2.5 text-neutral-900 dark:text-neutral-100">
            <option value="xiaoyun">小云（女声）</option>
            <option value="xiaogang">小刚（男声）</option>
            <option value="ruoxi">若兮（温柔女声）</option>
            <option value="siqi">思琪（温柔女声）</option>
            <option value="sijia">思佳（标准女声）</option>
            <option value="xiaobei">小北（萝莉女声）</option>
            <option value="aitong">艾彤（自然童声）</option>
            <option value="aiwa">艾娃（童真童声）</option>
            <option value="aixia">艾夏（自然女声）</option>
            <option value="guijia">桂佳（甜美女声）</option>
          </select>
        </div>
      </div>

      <!-- 密钥存储与合成按钮 -->
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <label class="flex items-center gap-2 text-sm text-neutral-700 dark:text-neutral-300 cursor-pointer">
          <input id="cloud-remember" type="checkbox" checked class="w-4 h-4" />
          记住密钥（仅存本机浏览器）
        </label>
        <button id="cloud-clear" class="text-sm text-red-500 hover:underline">清除已存密钥</button>
      </div>
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <button id="cloud-synth" class="px-5 py-2.5 rounded-xl bg-(--primary) text-white dark:text-black/70 font-medium hover:opacity-85 active:scale-95 transition">☁️ 云端合成</button>
        <span id="cloud-status" class="text-sm text-neutral-500 dark:text-neutral-400"></span>
      </div>

      <!-- 云端结果播放器 -->
      <div id="cloud-result" class="hidden rounded-xl border border-(--line-divider) bg-(--card-bg) px-4 py-3">
        <audio id="cloud-player" controls class="w-full mb-2"></audio>
        <a id="cloud-download" download="tts.mp3" class="text-sm text-(--primary) hover:underline cursor-pointer">⬇ 下载这段音频（mp3）</a>
      </div>
    </div>
  </div>

  
</div>
<script>
    const $ = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;

    const textEl = $<HTMLTextAreaElement>("tts-text");
    const voiceEl = $<HTMLSelectElement>("tts-voice");
    const rateEl = $<HTMLInputElement>("tts-rate");
    const pitchEl = $<HTMLInputElement>("tts-pitch");
    const volumeEl = $<HTMLInputElement>("tts-volume");
    const rateVal = $("tts-rate-val");
    const pitchVal = $("tts-pitch-val");
    const volumeVal = $("tts-volume-val");
    const speakBtn = $<HTMLButtonElement>("tts-speak");
    const stopBtn = $<HTMLButtonElement>("tts-stop");
    const statusEl = $("tts-status");
    const audioInput = $<HTMLInputElement>("tts-audio");
    const audioName = $("tts-audio-name");
    const analysisBox = $("tts-analysis");
    const applyBtn = $<HTMLButtonElement>("tts-apply");

    const supported = "speechSynthesis" in window;
    if (!supported) {
      $("tts-unsupported").classList.remove("hidden");
    }

    const setStatus = (msg: string) => { statusEl.textContent = msg; };
    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
    const round1 = (v: number) => Math.round(v * 10) / 10;

    // ---------- 声音列表 ----------
    let voices: SpeechSynthesisVoice[] = [];
    function loadVoices() {
      if (!supported) return;
      const vs = speechSynthesis.getVoices();
      if (!vs.length) return;
      voices = vs;
      const sorted = [...vs].sort((a, b) => {
        const az = a.lang.toLowerCase().startsWith("zh") ? 0 : 1;
        const bz = b.lang.toLowerCase().startsWith("zh") ? 0 : 1;
        return az - bz || a.lang.localeCompare(b.lang);
      });
      voiceEl.innerHTML = "";
      for (const v of sorted) {
        const opt = document.createElement("option");
        opt.value = v.name;
        opt.textContent = `${v.name}（${v.lang}）${v.localService ? "" : " · 网络"}`;
        voiceEl.appendChild(opt);
      }
      const zh = sorted.findIndex((v) => v.lang.toLowerCase().startsWith("zh"));
      voiceEl.selectedIndex = zh >= 0 ? zh : 0;
    }
    if (supported) {
      loadVoices();
      speechSynthesis.onvoiceschanged = loadVoices;
    }

    // ---------- 滑块显示 ----------
    function updateLabels() {
      rateVal.textContent = Number(rateEl.value).toFixed(1);
      pitchVal.textContent = Number(pitchEl.value).toFixed(1);
      volumeVal.textContent = Number(volumeEl.value).toFixed(1);
    }
    for (const el of [rateEl, pitchEl, volumeEl]) el.addEventListener("input", updateLabels);

    // ---------- 播放控制 ----------
    speakBtn.addEventListener("click", () => {
      if (!supported) return;
      const text = textEl.value.trim();
      if (!text) { setStatus("先输入点文字吧～"); return; }
      speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(text);
      const v = voices.find((x) => x.name === voiceEl.value);
      if (v) { u.voice = v; u.lang = v.lang; } else { u.lang = "zh-CN"; }
      u.rate = parseFloat(rateEl.value);
      u.pitch = parseFloat(pitchEl.value);
      u.volume = parseFloat(volumeEl.value);
      u.onstart = () => setStatus("正在本地合成并朗读…（设备卡顿属正常现象）");
      u.onend = () => setStatus("朗读完成 ✅");
      u.onerror = (e) => setStatus(`出错了：${e.error || "未知错误"}`);
      speechSynthesis.speak(u);
    });
    stopBtn.addEventListener("click", () => {
      if (!supported) return;
      speechSynthesis.cancel();
      setStatus("已停止");
    });

    // ---------- Web Audio 音频工作室 ----------
let audioCtx = null;
let bgmBuffer = null;
let studioBuffer = null;

function getAudioContext() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  return audioCtx;
}

// 创建混响脉冲响应
function createReverbImpulse(duration = 2.0, decay = 2.0) {
  const ctx = getAudioContext();
  const sampleRate = ctx.sampleRate;
  const length = sampleRate * duration;
  const impulse = ctx.createBuffer(2, length, sampleRate);
  for (let c = 0; c < 2; c++) {
    const channel = impulse.getChannelData(c);
    for (let i = 0; i < length; i++) {
      channel[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / length, decay);
    }
  }
  return impulse;
}

// 应用音频效果
async function applyAudioEffects(inputBuffer) {
  const ctx = getAudioContext();
  const offline = new OfflineAudioContext(
    inputBuffer.numberOfChannels,
    inputBuffer.length,
    inputBuffer.sampleRate
  );

  const source = offline.createBufferSource();
  source.buffer = inputBuffer;
  let node = source;

  // EQ 三段
  const eqLow = offline.createBiquadFilter();
  eqLow.type = 'lowshelf';
  eqLow.frequency.value = 320;
  eqLow.gain.value = parseFloat(document.getElementById('tts-eq-low').value);
  node.connect(eqLow); node = eqLow;

  const eqMid = offline.createBiquadFilter();
  eqMid.type = 'peaking';
  eqMid.frequency.value = 1000;
  eqMid.Q.value = 1.0;
  eqMid.gain.value = parseFloat(document.getElementById('tts-eq-mid').value);
  node.connect(eqMid); node = eqMid;

  const eqHigh = offline.createBiquadFilter();
  eqHigh.type = 'highshelf';
  eqHigh.frequency.value = 3200;
  eqHigh.gain.value = parseFloat(document.getElementById('tts-eq-high').value);
  node.connect(eqHigh); node = eqHigh;

  // 音色预设
  const timbre = document.getElementById('tts-timbre').value;
  if (timbre === 'warm') {
    eqLow.gain.value += 4;
    eqHigh.gain.value -= 2;
  } else if (timbre === 'bright') {
    eqHigh.gain.value += 5;
    eqLow.gain.value -= 1;
  } else if (timbre === 'phone') {
    const bandpass = offline.createBiquadFilter();
    bandpass.type = 'bandpass';
    bandpass.frequency.value = 1000;
    bandpass.Q.value = 0.8;
    node.connect(bandpass); node = bandpass;
  } else if (timbre === 'robot') {
    const shaper = offline.createWaveShaper();
    const curve = new Float32Array(256);
    for (let i = 0; i < 256; i++) {
      const x = (i - 128) / 128;
      curve[i] = Math.sign(x) * Math.pow(Math.abs(x), 0.5);
    }
    shaper.curve = curve;
    node.connect(shaper); node = shaper;
  }

  // 混响
  const reverbVal = parseFloat(document.getElementById('tts-reverb').value);
  if (reverbVal > 0) {
    const convolver = offline.createConvolver();
    convolver.buffer = createReverbImpulse(reverbVal / 50, 2.0);
    const dryGain = offline.createGain();
    const wetGain = offline.createGain();
    dryGain.gain.value = 1 - (reverbVal / 100);
    wetGain.gain.value = reverbVal / 100;

    node.connect(dryGain);
    node.connect(convolver);
    convolver.connect(wetGain);

    const merger = offline.createGain();
    dryGain.connect(merger);
    wetGain.connect(merger);
    node = merger;
  }

  // 声像
  const panVal = parseFloat(document.getElementById('tts-pan').value) / 100;
  const panner = offline.createStereoPanner();
  panner.pan.value = panVal;
  node.connect(panner); node = panner;

  // 淡入淡出
  const fadeMode = document.getElementById('tts-fade').value;
  const fadeGain = offline.createGain();
  fadeGain.gain.value = 1;
  const dur = inputBuffer.duration;
  if (fadeMode === 'in' || fadeMode === 'both') {
    fadeGain.gain.setValueAtTime(0.001, 0);
    fadeGain.gain.exponentialRampToValueAtTime(1, Math.min(0.5, dur * 0.1));
  }
  if ((fadeMode === 'out' || fadeMode === 'both') && dur > 1) {
    fadeGain.gain.setValueAtTime(1, dur - 0.5);
    fadeGain.gain.exponentialRampToValueAtTime(0.001, dur);
  }
  panner.connect(fadeGain); node = fadeGain;

  // BGM 混合
  if (bgmBuffer) {
    const bgmSource = offline.createBufferSource();
    bgmSource.buffer = bgmBuffer;
    bgmSource.loop = true;
    const bgmGain = offline.createGain();
    bgmGain.gain.value = parseFloat(document.getElementById('tts-bgm-vol').value) / 100;
    bgmSource.connect(bgmGain);
    bgmGain.connect(offline.destination);
    bgmSource.start(0);
  }

  node.connect(offline.destination);
  source.start(0);

  return await offline.startRendering();
}

