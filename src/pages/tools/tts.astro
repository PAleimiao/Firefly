// ---------- 录音特征分析 ----------
    let analysisResult: { pitch: number; rate: number } | null = null;

    /** 简单抽取降采样（音高分析足够用） */
    function downsample(data: Float32Array, factor: number): Float32Array {
      const out = new Float32Array(Math.floor(data.length / factor));
      for (let i = 0; i < out.length; i++) out[i] = data[i * factor];
      return out;
    }

    /** 自相关法估算基频（Hz），返回中位数 */
    function estimateF0(raw: Float32Array, origSr: number): number | null {
      const factor = Math.max(1, Math.round(origSr / 11025));
      const data = downsample(raw, factor);
      const sr = origSr / factor;
      const frame = 1024, hop = 512;
      const minLag = Math.floor(sr / 500), maxLag = Math.floor(sr / 60);
      let maxRms = 0;
      const rmsList: number[] = [];
      for (let i = 0; i + frame <= data.length; i += hop) {
        let s = 0;
        for (let j = 0; j < frame; j++) s += data[i + j] * data[i + j];
        const rms = Math.sqrt(s / frame);
        rmsList.push(rms);
        if (rms > maxRms) maxRms = rms;
      }
      if (maxRms <= 0) return null;
      const threshold = maxRms * 0.3;
      const f0s: number[] = [];
      let fi = 0;
      for (let i = 0; i + frame <= data.length; i += hop, fi++) {
        if (rmsList[fi] < threshold) continue;
        let bestLag = -1, bestCorr = 0.3;
        for (let lag = minLag; lag <= maxLag; lag++) {
          let sum = 0, e0 = 0, e1 = 0;
          const n = frame - lag;
          for (let j = 0; j < n; j++) {
            const a = data[i + j], b = data[i + j + lag];
            sum += a * b; e0 += a * a; e1 += b * b;
          }
          const corr = sum / Math.sqrt(e0 * e1 + 1e-12);
          if (corr > bestCorr) { bestCorr = corr; bestLag = lag; }
        }
        if (bestLag > 0) f0s.push(sr / bestLag);
      }
      if (!f0s.length) return null;
      f0s.sort((a, b) => a - b);
      return f0s[Math.floor(f0s.length / 2)];
    }

    /** 能量包络起始点法估算语速（音节/秒） */
    function estimateSPS(data: Float32Array, sr: number): number | null {
      const win = Math.floor(sr * 0.01);
      const env: number[] = [];
      let maxE = 0;
      for (let i = 0; i + win <= data.length; i += win) {
        let s = 0;
        for (let j = 0; j < win; j++) s += data[i + j] * data[i + j];
        const e = Math.sqrt(s / win);
        env.push(e);
        if (e > maxE) maxE = e;
      }
      if (maxE <= 0) return null;
      const th = maxE * 0.25;
      let onsets = 0, voiced = 0, inSyllable = false;
      for (const e of env) {
        if (e > th) {
          voiced++;
          if (!inSyllable) { onsets++; inSyllable = true; }
        } else if (e < th * 0.6) {
          inSyllable = false;
        }
      }
      const voicedSec = voiced * 0.01;
      if (voicedSec < 1 || onsets < 2) return null;
      return onsets / voicedSec;
    }

    audioInput.addEventListener("change", async () => {
      const file = audioInput.files?.[0];
      if (!file) return;
      analysisResult = null;
      applyBtn.classList.add("hidden");
      audioName.textContent = file.name;
      analysisBox.classList.remove("hidden");
      analysisBox.textContent = "正在本地分析录音…（可能需要几秒，设备卡顿属正常现象）";
      try {
        const buf = await file.arrayBuffer();
        const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        const ctx = new AC();
        const audio = await ctx.decodeAudioData(buf);
        void ctx.close?.();
        const sr = audio.sampleRate;
        // 混合所有声道并截取前 20 秒
        let data = new Float32Array(audio.length);
        for (let c = 0; c < audio.numberOfChannels; c++) {
          const ch = audio.getChannelData(c);
          for (let i = 0; i < ch.length; i++) data[i] += ch[i] / audio.numberOfChannels;
        }
        const maxLen = sr * 20;
        if (data.length > maxLen) data = data.slice(0, maxLen);

        const f0 = estimateF0(data, sr);
        const sps = estimateSPS(data, sr);
        if (!f0 && !sps) {
          analysisBox.textContent = "没能在录音里识别到清晰人声，换一段更干净的录音试试。";
          return;
        }
        const pitchParam = f0 ? round1(clamp(f0 / 165, 0.5, 2)) : 1;
        const rateParam = sps ? round1(clamp(sps / 4.5, 0.5, 2)) : 1;
        analysisResult = { pitch: pitchParam, rate: rateParam };
        const f0Text = f0
          ? `${Math.round(f0)} Hz（${f0 < 150 ? "偏低沉" : f0 < 250 ? "中等" : "偏尖亮"}）`
          : "未测出";
        const spsText = sps
          ? `${sps.toFixed(1)} 音节/秒（${sps < 3.5 ? "偏慢" : sps < 5.5 ? "中等" : "偏快"}）`
          : "未测出";
        analysisBox.innerHTML =
          `分析完成：<br>· 估算音高（基频）：<b>${f0Text}</b> → 音高参数 <b>${pitchParam.toFixed(1)}</b>` +
          `<br>· 估算语速：<b>${spsText}</b> → 语速参数 <b>${rateParam.toFixed(1)}</b>` +
          `<br>点击下方按钮套用这两个特征，再点「开始朗读」听听效果。`;
        applyBtn.classList.remove("hidden");
      } catch {
        analysisBox.textContent = "录音解码失败，可能是格式不支持，换 mp3 / wav / m4a 试试。";
      }
    });

    applyBtn.addEventListener("click", () => {
      if (!analysisResult) return;
      pitchEl.value = String(analysisResult.pitch);
      rateEl.value = String(analysisResult.rate);
      updateLabels();
      setStatus("已套用模仿参数，点「开始朗读」试听 🎧");
    });

    // ---------- 自备云端 API ----------
    const cloudTabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".cloud-tab"));
    const openaiBox = $("cloud-openai");
    const aliyunBox = $("cloud-aliyun");
    const oaiKeyEl = $<HTMLInputElement>("oai-key");
    const oaiBaseEl = $<HTMLInputElement>("oai-base");
    const oaiModelEl = $<HTMLSelectElement>("oai-model");
    const oaiVoiceEl = $<HTMLSelectElement>("oai-voice");
    const aliAppkeyEl = $<HTMLInputElement>("ali-appkey");
    const aliTokenEl = $<HTMLInputElement>("ali-token");
    const aliVoiceEl = $<HTMLSelectElement>("ali-voice");
    const rememberEl = $<HTMLInputElement>("cloud-remember");
    const cloudBtn = $<HTMLButtonElement>("cloud-synth");
    const cloudStatus = $("cloud-status");
    const cloudResult = $("cloud-result");
    const cloudPlayer = $<HTMLAudioElement>("cloud-player");
    const cloudDownload = $<HTMLAnchorElement>("cloud-download");

    let provider: "openai" | "aliyun" = "openai";
    const LS_KEYS = ["tts_oai_key", "tts_oai_base", "tts_ali_appkey", "tts_ali_token"];

    const setCloudStatus = (msg: string) => { cloudStatus.textContent = msg; };

    function switchProvider(p: "openai" | "aliyun") {
      provider = p;
      for (const tab of cloudTabs) {
        const active = tab.dataset.provider === p;
        tab.classList.toggle("bg-(--primary)", active);
        tab.classList.toggle("text-white", active);
        tab.classList.toggle("bg-(--btn-regular-bg)", !active);
        tab.classList.toggle("text-(--btn-content)", !active);
      }
      openaiBox.classList.toggle("hidden", p !== "openai");
      openaiBox.classList.toggle("flex", p === "openai");
      aliyunBox.classList.toggle("hidden", p !== "aliyun");
      aliyunBox.classList.toggle("flex", p === "aliyun");
      setCloudStatus("");
    }
    for (const tab of cloudTabs) {
      tab.addEventListener("click", () => switchProvider(tab.dataset.provider as "openai" | "aliyun"));
    }

    // 载入已存密钥
    oaiKeyEl.value = localStorage.getItem("tts_oai_key") || "";
    oaiBaseEl.value = localStorage.getItem("tts_oai_base") || "";
    aliAppkeyEl.value = localStorage.getItem("tts_ali_appkey") || "";
    aliTokenEl.value = localStorage.getItem("tts_ali_token") || "";

    function persistKeys() {
      if (rememberEl.checked) {
        localStorage.setItem("tts_oai_key", oaiKeyEl.value.trim());
        localStorage.setItem("tts_oai_base", oaiBaseEl.value.trim());
        localStorage.setItem("tts_ali_appkey", aliAppkeyEl.value.trim());
        localStorage.setItem("tts_ali_token", aliTokenEl.value.trim());
      } else {
        for (const k of LS_KEYS) localStorage.removeItem(k);
      }
    }

    $("cloud-clear").addEventListener("click", () => {
      for (const k of LS_KEYS) localStorage.removeItem(k);
      oaiKeyEl.value = ""; oaiBaseEl.value = "";
      aliAppkeyEl.value = ""; aliTokenEl.value = "";
      setCloudStatus("已清除本机保存的密钥");
    });

    function playBlob(blob: Blob) {
      const url = URL.createObjectURL(blob);
      cloudPlayer.src = url;
      cloudDownload.href = url;
      cloudResult.classList.remove("hidden");
      void cloudPlayer.play().catch(() => { /* 自动播放被拦截就让用户手动点 */ });
    }

    async function synthOpenAI(text: string) {
      const key = oaiKeyEl.value.trim();
      if (!key) { setCloudStatus("先填你的 OpenAI API Key"); return; }
      const base = (oaiBaseEl.value.trim() || "https://api.openai.com/v1").replace(/\/+$/, "");
      persistKeys();
      setCloudStatus("正在请求 OpenAI 云端合成…（费用走你自己的账号）");
      const resp = await fetch(`${base}/audio/speech`, {
        method: "POST",
        headers: { Authorization: `Bearer ${key}`, "Content-Type": "application/json" },
        body: JSON.stringify({
          model: oaiModelEl.value,
          voice: oaiVoiceEl.value,
          input: text,
          response_format: "mp3",
        }),
      });
      if (!resp.ok) {
        const t = await resp.text();
        throw new Error(`OpenAI 返回 HTTP ${resp.status}：${t.slice(0, 150)}`);
      }
      playBlob(await resp.blob());
      setCloudStatus("合成完成 ✅ 可在线听或下载");
    }

    async function synthAliyun(text: string) {
      const appkey = aliAppkeyEl.value.trim();
      const token = aliTokenEl.value.trim();
      if (!appkey || !token) { setCloudStatus("先填阿里云 AppKey 和 Token"); return; }
      persistKeys();
      setCloudStatus("正在请求阿里云云端合成…（费用走你自己的账号）");
      const resp = await fetch("https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/tts", {
        method: "POST",
        headers: { "Content-Type": "application/json", "X-NLS-Token": token },
        body: JSON.stringify({
          appkey,
          token,
          text,
          voice: aliVoiceEl.value,
          format: "mp3",
          sample_rate: 16000,
          volume: 50,
          speech_rate: 0,
          pitch_rate: 0,
        }),
      });
      if (!resp.ok) {
        const t = await resp.text();
        throw new Error(`阿里云返回 HTTP ${resp.status}：${t.slice(0, 150)}`);
      }
      playBlob(await resp.blob());
      setCloudStatus("合成完成 ✅ 可在线听或下载");
    }

    cloudBtn.addEventListener("click", async () => {
      const text = textEl.value.trim();
      if (!text) { setCloudStatus("先在上面输入点文字吧～"); return; }
      cloudBtn.setAttribute("disabled", "true");
      try {
        if (provider === "openai") await synthOpenAI(text);
        else await synthAliyun(text);
      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        if (msg.includes("Failed to fetch") || msg.includes("NetworkError")) {
          setCloudStatus("请求被浏览器拦截（对方不允许网页跨域直连），可改用自定义接口地址走中转，或换另一家试试");
        } else {
          setCloudStatus(msg);
        }
      } finally {
        cloudBtn.removeAttribute("disabled");
      }
    });

    switchProvider("openai");
  
// Tab 切换
document.querySelectorAll('.tts-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    const target = tab.dataset.tab;
    document.querySelectorAll('.tts-tab').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
    document.querySelectorAll('.tts-tab-panel').forEach(p => p.classList.remove('active'));
    document.getElementById('tab-' + target).classList.add('active');
  });
});

