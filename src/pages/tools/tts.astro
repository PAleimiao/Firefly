  function loadLocalVoices(selectEl, selectedName) {
    if (!selectEl) return;
    const voices = speechSynthesis.getVoices();
    if (!voices.length) {
      selectEl.innerHTML = '<option value="">加载中...</option>';
      return;
    }
    selectEl.innerHTML = '<option value="">默认</option>';
    const groups = {};
    voices.forEach(v => {
      const lang = v.lang.split('-')[0];
      if (!groups[lang]) groups[lang] = [];
      groups[lang].push(v);
    });
    const order = ['zh','en','ja','ko'].filter(k => groups[k]).concat(Object.keys(groups).filter(k => !['zh','en','ja','ko'].includes(k)));
    const names = {zh:'中文', en:'English', ja:'日本語', ko:'한국어'};
    order.forEach(lang => {
      const grp = document.createElement('optgroup');
      grp.label = names[lang] || lang.toUpperCase();
      groups[lang].forEach(v => {
        const opt = document.createElement('option');
        opt.value = v.name;
        opt.textContent = v.name;
        if (v.name === selectedName) opt.selected = true;
        grp.appendChild(opt);
      });
      selectEl.appendChild(grp);
    });
  }

  // ==================== 播放逻辑 ====================
  async function playTrack(id) {
    const t = tracks.find(tr => tr.id === id);
    if (!t || !t.text.trim()) { showToast('请输入文本', 'warn'); return; }

    stopAll();
    const el = document.getElementById(`track-${id}`);
    const status = el.querySelector('.track-status');
    status.textContent = '合成中...';

    try {
      if (t.source === 'local') {
        await playLocal(t, status);
      } else if (t.source === 'edge') {
        await playEdge(t, status);
      } else if (t.source === 'aliyun') {
        await playAliyun(t, status);
      } else if (t.source === 'openai') {
        await playOpenAI(t, status);
      } else if (t.source === 'azure') {
        await playAzure(t, status);
      } else if (t.source === 'localapi') {
        await playLocalApi(t, status);
      }
    } catch (err) {
      status.textContent = '失败';
      showToast(err.message || '播放失败', 'error');
    }
  }

  function stopAll() {
    if (currentAudio) { currentAudio.pause(); currentAudio = null; }
    speechSynthesis.cancel();
    isPlaying = false;
    document.getElementById('btn-stop').classList.add('hidden');
    document.querySelectorAll('.track-status').forEach(s => s.textContent = '就绪');
  }

  // ----- 本地浏览器 -----
  function playLocal(t, status) {
    return new Promise((resolve, reject) => {
      speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(t.text);
      const p = t.params;
      u.voice = speechSynthesis.getVoices().find(v => v.name === p.voice) || null;
      u.rate = p.rate;
      u.pitch = p.pitch;
      u.volume = p.volume;
      u.onstart = () => { status.textContent = '朗读中...'; isPlaying = true; document.getElementById('btn-stop').classList.remove('hidden'); };
      u.onend = () => { status.textContent = '就绪'; isPlaying = false; document.getElementById('btn-stop').classList.add('hidden'); resolve(); };
      u.onerror = () => { status.textContent = '出错'; reject(new Error('朗读失败')); };
      speechSynthesis.speak(u);
    });
  }

  // ----- Edge TTS -----
  class EdgeTTS {
    constructor() { this.chunks = []; }
    async synthesize(text, voice = 'zh-CN-XiaoxiaoNeural', style = 'general', rate = 0, pitch = 0) {
      return new Promise((resolve, reject) => {
        this.chunks = [];
        const token = '6A5AA1D4EAFF4E9FB37E23D68491D6F4';
        const ws = new WebSocket(`wss://speech.platform.bing.com/consumer/speech/synthesize/readaloud/edge/v1?TrustedClientToken=${token}`);
        ws.onopen = () => {
          const config = { context: { synthesis: { audio: { metadataOptions: { sentenceBoundaryEnabled: false, wordBoundaryEnabled: false }, outputFormat: 'audio-24khz-48kbitrate-mono-mp3' } } } };
          ws.send(`X-Timestamp:${new Date().toISOString()}\nContent-Type:application/json; charset=utf-8\nPath:speech.config\n\n${JSON.stringify(config)}`);
          let styleStr = style && style !== 'general' ? ` style="${style}"` : '';
          let rateStr = rate !== 0 ? ` rate="${rate > 0 ? '+' : ''}${rate}%"` : '';
          let pitchStr = pitch !== 0 ? ` pitch="${pitch > 0 ? '+' : ''}${pitch}Hz"` : '';
          const ssml = `<speak version='1.0' xmlns='http://www.w3.org/2001/10/synthesis' xml:lang='zh-CN'><voice name='${voice}'${styleStr}${rateStr}${pitchStr}>${text.replace(/[<>]/g, '')}</voice></speak>`;
          ws.send(`X-Timestamp:${new Date().toISOString()}\nContent-Type:application/ssml+xml\nPath:ssml\n\n${ssml}`);
        };
        ws.onmessage = (e) => { if (e.data instanceof Blob) this.chunks.push(e.data); };
        ws.onclose = () => {
          if (this.chunks.length > 0) resolve(new Blob(this.chunks, { type: 'audio/mpeg' }));
          else reject(new Error('未收到音频'));
        };
        ws.onerror = (err) => reject(err);
      });
    }
  }
  const edgeTTS = new EdgeTTS();

  async function playEdge(t, status) {
    const p = t.params;
    const blob = await edgeTTS.synthesize(t.text, p.edgeVoice, p.edgeStyle, p.edgeRate, p.edgePitch);
    const url = URL.createObjectURL(blob);
    currentAudio = new Audio(url);
    currentAudio.play();
    status.textContent = '播放中...';
    isPlaying = true;
    document.getElementById('btn-stop').classList.remove('hidden');
    currentAudio.onended = () => { status.textContent = '就绪'; isPlaying = false; document.getElementById('btn-stop').classList.add('hidden'); };
  }

  // ----- 阿里云 -----
  async function playAliyun(t, status) {
    const cfg = getApiConfig();
    if (!cfg['ak-id'] || !cfg['ak-secret'] || !cfg['ak-appkey']) {
      throw new Error('请先配置阿里云API密钥');
    }
    // 阿里云语音合成REST API (极简版，通过HTTP直接调用)
    // 由于前端签名复杂，这里使用一个简化的方案：直接调用token接口
    status.textContent = '请求中...';

    // 构建请求参数
    const params = new URLSearchParams();
    params.append('appkey', cfg['ak-appkey']);
    params.append('text', t.text);
    params.append('format', 'mp3');
    params.append('sample_rate', '16000');
    params.append('voice', t.params.aliVoice);
    params.append('speech_rate', String(t.params.aliRate));
    params.append('pitch_rate', String(t.params.aliPitch));
    params.append('volume', String(t.params.aliVolume));

    // 注意：阿里云REST API需要签名，前端直接调用有CORS和签名问题
    // 这里提供一个替代方案：使用阿里云的NLS WebSocket接口（需要token）
    // 但由于签名复杂，我们提示用户使用本地代理或后端

    // 实际上，阿里云语音合成有直接的HTTP接口，但需要签名
    // 为了简化，这里我们尝试直接fetch（可能会因CORS失败）
    try {
      const resp = await fetch('https://nls-gateway.aliyuncs.com/stream/v1/tts?' + params.toString(), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      if (!resp.ok) throw new Error('HTTP ' + resp.status);
      const blob = await resp.blob();
      const url = URL.createObjectURL(blob);
      currentAudio = new Audio(url);
      currentAudio.play();
      status.textContent = '播放中...';
      isPlaying = true;
      document.getElementById('btn-stop').classList.remove('hidden');
      currentAudio.onended = () => { status.textContent = '就绪'; isPlaying = false; document.getElementById('btn-stop').classList.add('hidden'); };
    } catch (e) {
      // 如果CORS失败，提示用户
      throw new Error('阿里云TTS需要后端代理或本地签名。建议：1)使用本地API模式调用本地部署的TTS 2)使用Edge/本地浏览器代替');
    }
  }

