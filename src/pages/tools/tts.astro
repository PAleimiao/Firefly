---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="语音合成工坊" description="多引擎TTS合成：本地浏览器、Edge、阿里云、OpenAI、Azure、本地API。支持多音轨混音、音色调节、GPU本地渲染。">
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative w-full">

      <!-- 页面标题 -->
      <div class="flex items-center gap-3 mb-2">
        <div class="h-10 w-10 rounded-xl bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
          <svg class="text-[1.75rem]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/><path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/></svg>
        </div>
        <div>
          <div class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">语音合成工坊</div>
          <div class="text-sm text-neutral-500 dark:text-neutral-400">多引擎 · 多音轨 · 音色随心调</div>
        </div>
        <button id="btn-api-config" class="ml-auto px-4 py-2 rounded-xl bg-(--btn-regular-bg) text-(--btn-content) border border-(--line-divider) hover:opacity-85 active:scale-95 transition text-sm font-medium flex items-center gap-2">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84a.484.484 0 0 0-.48.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.488.488 0 0 0-.59.22L3.16 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.48-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
          API配置
        </button>
      </div>

      <!-- API配置面板 (默认折叠) -->
      <div id="api-config-panel" class="hidden rounded-xl border border-(--line-divider) bg-(--card-bg) px-5 py-4 mb-4">
        <div class="flex items-center justify-between mb-3">
          <div class="text-lg font-bold text-neutral-900 dark:text-neutral-100">🔑 API密钥配置</div>
          <div class="text-xs text-neutral-500 dark:text-neutral-400">仅保存在本地浏览器，不会上传服务器</div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1">阿里云 AccessKeyId</label>
            <input id="ak-id" type="text" placeholder="LTAI..." class="w-full rounded-lg bg-(--bg) border border-(--line-divider) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary)">
          </div>
          <div>
            <label class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1">阿里云 AccessKeySecret</label>
            <input id="ak-secret" type="password" placeholder="********" class="w-full rounded-lg bg-(--bg) border border-(--line-divider) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary)">
          </div>
          <div>
            <label class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1">阿里云 AppKey</label>
            <input id="ak-appkey" type="text" placeholder="xxx" class="w-full rounded-lg bg-(--bg) border border-(--line-divider) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary)">
          </div>
          <div>
            <label class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1">OpenAI API Key</label>
            <input id="openai-key" type="password" placeholder="sk-..." class="w-full rounded-lg bg-(--bg) border border-(--line-divider) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary)">
          </div>
          <div>
            <label class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1">Azure Speech Key</label>
            <input id="azure-key" type="password" placeholder="********" class="w-full rounded-lg bg-(--bg) border border-(--line-divider) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary)">
          </div>
          <div>
            <label class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1">Azure Region</label>
            <input id="azure-region" type="text" placeholder="southeastasia" value="southeastasia" class="w-full rounded-lg bg-(--bg) border border-(--line-divider) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary)">
          </div>
          <div class="md:col-span-2 lg:col-span-3">
            <label class="block text-xs font-medium text-neutral-600 dark:text-neutral-400 mb-1">本地API地址 (如 Piper/MMS 本地服务)</label>
            <input id="local-api-url" type="text" placeholder="http://localhost:5000/api/tts" class="w-full rounded-lg bg-(--bg) border border-(--line-divider) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary)">
            <div class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">💡 本地部署Piper/MMS等TTS后填写，可调用本地GPU渲染</div>
          </div>
        </div>
        <div class="flex gap-3 mt-4">
          <button id="btn-save-api" class="px-5 py-2 rounded-xl bg-(--primary) text-white dark:text-black/70 font-medium hover:opacity-85 active:scale-95 transition text-sm">💾 保存到本地</button>
          <button id="btn-clear-api" class="px-5 py-2 rounded-xl bg-(--btn-regular-bg) text-(--btn-content) border border-(--line-divider) hover:opacity-85 active:scale-95 transition text-sm">🗑️ 清空</button>
        </div>
      </div>

      <!-- 全局控制栏 -->
      <div class="flex flex-wrap items-center gap-3 mb-4 p-3 rounded-xl border border-(--line-divider) bg-(--bg)">
        <button id="btn-add-track" class="px-4 py-2 rounded-xl bg-(--primary) text-white dark:text-black/70 font-medium hover:opacity-85 active:scale-95 transition text-sm flex items-center gap-2">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
          添加音轨
        </button>
        <button id="btn-play-all" class="px-4 py-2 rounded-xl bg-(--btn-regular-bg) text-(--btn-content) border border-(--line-divider) hover:opacity-85 active:scale-95 transition text-sm flex items-center gap-2">
          <Icon is:inline name="material-symbols:play-arrow" class="text-[1.1rem]"></Icon>
          顺序播放
        </button>
        <button id="btn-merge" class="px-4 py-2 rounded-xl bg-(--btn-regular-bg) text-(--btn-content) border border-(--line-divider) hover:opacity-85 active:scale-95 transition text-sm flex items-center gap-2">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" opacity=".5"/><path d="M5 5v14l11-7z"/></svg>
          合并导出
        </button>
        <button id="btn-stop" class="px-4 py-2 rounded-xl bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/30 hover:opacity-85 active:scale-95 transition text-sm flex items-center gap-2 hidden">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6 6h12v12H6z"/></svg>
          停止
        </button>
        <div class="ml-auto text-sm text-neutral-500 dark:text-neutral-400" id="global-status">就绪 · 0 个音轨</div>
      </div>

      <!-- 音轨列表 -->
      <div id="track-list" class="space-y-4">
        <!-- 音轨由JS动态生成 -->
      </div>

      <!-- 空状态 -->
      <div id="empty-state" class="text-center py-12 text-neutral-400 dark:text-neutral-500">
        <svg class="w-12 h-12 mx-auto mb-3 opacity-50" fill="currentColor" viewBox="0 0 24 24"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
        <div class="text-lg">还没有音轨</div>
        <div class="text-sm mt-1">点击上方「添加音轨」开始创作</div>
      </div>

    </div>
  </div>
</MainGridLayout>

<script>
  // ==================== 全局状态 ====================
  let tracks = [];
  let currentAudio = null;
  let isPlaying = false;
  let trackIdCounter = 0;

  // ==================== API配置管理 ====================
  const API_KEYS = ['ak-id', 'ak-secret', 'ak-appkey', 'openai-key', 'azure-key', 'azure-region', 'local-api-url'];

  function loadApiConfig() {
    API_KEYS.forEach(k => {
      const el = document.getElementById(k);
      if (el) el.value = localStorage.getItem('tts_' + k) || '';
    });
  }

  function saveApiConfig() {
    API_KEYS.forEach(k => {
      const el = document.getElementById(k);
      if (el) localStorage.setItem('tts_' + k, el.value.trim());
    });
    showToast('API配置已保存到本地浏览器', 'success');
  }

  function clearApiConfig() {
    API_KEYS.forEach(k => {
      localStorage.removeItem('tts_' + k);
      const el = document.getElementById(k);
      if (el) el.value = '';
    });
    showToast('已清空', 'warn');
  }

  function getApiConfig() {
    const cfg = {};
    API_KEYS.forEach(k => {
      cfg[k] = localStorage.getItem('tts_' + k) || '';
    });
    return cfg;
  }

  // ==================== Toast提示 ====================
  function showToast(msg, type = 'info') {
    const toast = document.createElement('div');
    toast.className = `fixed bottom-4 right-4 px-4 py-3 rounded-xl text-sm font-medium z-50 transition-all duration-300 translate-x-full ${
      type === 'success' ? 'bg-green-500 text-white' :
      type === 'error' ? 'bg-red-500 text-white' :
      type === 'warn' ? 'bg-amber-500 text-black' :
      'bg-(--primary) text-white dark:text-black'
    }`;
    toast.textContent = msg;
    document.body.appendChild(toast);
    requestAnimationFrame(() => toast.classList.remove('translate-x-full'));
    setTimeout(() => {
      toast.classList.add('translate-x-full');
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  // ==================== 语音源配置 ====================
  const SOURCE_CONFIG = {
    local: {
      name: '🎙️ 本地浏览器',
      desc: '免费 · 离线 · 设备自带',
      hasDownload: false,
      params: ['voice', 'rate', 'pitch', 'volume']
    },
    edge: {
      name: '🌐 Edge 在线',
      desc: '免费 · 微软 · 更自然',
      hasDownload: true,
      params: ['edgeVoice', 'edgeStyle', 'edgeRate', 'edgePitch']
    },
    aliyun: {
      name: '🔷 阿里云',
      desc: '需API密钥 · 超自然中文',
      hasDownload: true,
      params: ['aliVoice', 'aliRate', 'aliPitch', 'aliVolume', 'aliEmotion']
    },
    openai: {
      name: '🤖 OpenAI',
      desc: '需API密钥 · 英文极佳',
      hasDownload: true,
      params: ['oaVoice', 'oaSpeed']
    },
    azure: {
      name: '🔵 Azure',
      desc: '需API密钥 · 微软正版',
      hasDownload: true,
      params: ['azVoice', 'azStyle', 'azRate', 'azPitch']
    },
    localapi: {
      name: '🏠 本地API',
      desc: '本地GPU渲染 · Piper/MMS',
      hasDownload: true,
      params: ['lapiVoice', 'lapiRate', 'lapiParams']
    }
  };

  // 音色选项数据
  const EDGE_VOICES = [
    {v:'zh-CN-XiaoxiaoNeural',n:'晓晓 — 女声(自然)'},{v:'zh-CN-YunxiNeural',n:'云希 — 男声(自然)'},
    {v:'zh-CN-XiaohanNeural',n:'晓涵 — 温柔女声'},{v:'zh-CN-XiaomengNeural',n:'晓梦 — 知性女声'},
    {v:'zh-CN-XiaoyiNeural',n:'晓伊 — 女童声'},{v:'zh-CN-YunjianNeural',n:'云健 — 解说男声'},
    {v:'zh-CN-YunxiaNeural',n:'云夏 — 活泼男声'},{v:'zh-CN-YunyangNeural',n:'云扬 — 新闻男声'},
    {v:'zh-CN-XiaochenNeural',n:'晓晨 — 成熟女声'},{v:'zh-CN-XiaoyanNeural',n:'晓颜 — 亲切女声'},
    {v:'zh-HK-HiuMaanNeural',n:'粤语 — 晓曼'},{v:'zh-TW-HsiaoChenNeural',n:'台湾 — 晓臻'},
    {v:'ja-JP-NanamiNeural',n:'日语 — 七海'},{v:'en-US-AriaNeural',n:'英语 — Aria'},
    {v:'en-US-GuyNeural',n:'英语 — Guy'},{v:'ko-KR-SunHiNeural',n:'韩语 — SunHi'}
  ];
  const EDGE_STYLES = ['general','cheerful','sad','angry','fearful','disgusted','serious','gentle','depressed'];

  const ALI_VOICES = [
    {v:'zhixiaoning',n:'知小凝 — 知性女声'},{v:'zhixiaowan',n:'知小婉 — 温柔女声'},
    {v:'zhixiaobei',n:'知小北 — 活泼女声'},{v:'zhixiaonan',n:'知小南 — 成熟男声'},
    {v:'zhixiaomo',n:'知小墨 — 磁性男声'},{v:'zhixiaoyao',n:'知小瑶 — 可爱女声'},
    {v:'zhixiaoxuan',n:'知小轩 — 阳光男声'},{v:'zhixiaotong',n:'知小童 — 萝莉女声'}
  ];
  const ALI_EMOTIONS = ['neutral','happy','sad','angry','fear','surprise','disgust','neutral'];

  const OA_VOICES = ['alloy','echo','fable','onyx','nova','shimmer'];

  const AZ_VOICES = [
    {v:'zh-CN-XiaoxiaoNeural',n:'晓晓 — 中文女声'},{v:'zh-CN-YunxiNeural',n:'云希 — 中文男声'},
    {v:'zh-CN-XiaohanNeural',n:'晓涵 — 中文温柔'},{v:'ja-JP-NanamiNeural',n:'七海 — 日语'},
    {v:'en-US-AriaNeural',n:'Aria — 英语'},{v:'ko-KR-SunHiNeural',n:'SunHi — 韩语'}
  ];
  const AZ_STYLES = ['general','cheerful','sad','angry','fearful','disgusted','serious','gentle'];

  // ==================== 音轨管理 ====================
  function addTrack(data = null) {
    const id = ++trackIdCounter;
    const track = {
      id,
      text: data?.text || '',
      source: data?.source || 'edge',
      params: data?.params || getDefaultParams('edge')
    };
    tracks.push(track);
    renderTrack(track);
    updateEmptyState();
    updateGlobalStatus();
    return track;
  }

  function getDefaultParams(source) {
    const defaults = {
      local: { voice: '', rate: 1, pitch: 1, volume: 1 },
      edge: { edgeVoice: 'zh-CN-XiaoxiaoNeural', edgeStyle: 'general', edgeRate: 0, edgePitch: 0 },
      aliyun: { aliVoice: 'zhixiaoning', aliRate: 0, aliPitch: 0, aliVolume: 50, aliEmotion: 'neutral' },
      openai: { oaVoice: 'alloy', oaSpeed: 1 },
      azure: { azVoice: 'zh-CN-XiaoxiaoNeural', azStyle: 'general', azRate: 0, azPitch: 0 },
      localapi: { lapiVoice: 'default', lapiRate: 1, lapiParams: '' }
    };
    return JSON.parse(JSON.stringify(defaults[source] || defaults.edge));
  }

  function removeTrack(id) {
    tracks = tracks.filter(t => t.id !== id);
    const el = document.getElementById(`track-${id}`);
    if (el) el.remove();
    updateEmptyState();
    updateGlobalStatus();
  }

  function duplicateTrack(id) {
    const t = tracks.find(tr => tr.id === id);
    if (!t) return;
    addTrack({ text: t.text, source: t.source, params: JSON.parse(JSON.stringify(t.params)) });
  }

  function moveTrack(id, dir) {
    const idx = tracks.findIndex(t => t.id === id);
    if (idx === -1) return;
    const newIdx = idx + dir;
    if (newIdx < 0 || newIdx >= tracks.length) return;
    [tracks[idx], tracks[newIdx]] = [tracks[newIdx], tracks[idx]];
    // 重新渲染全部
    document.getElementById('track-list').innerHTML = '';
    tracks.forEach(t => renderTrack(t));
  }

  function updateTrackData(id) {
    const t = tracks.find(tr => tr.id === id);
    if (!t) return;
    const el = document.getElementById(`track-${id}`);
    t.text = el.querySelector('.track-text').value;
    t.source = el.querySelector('.track-source').value;

    // 读取各参数
    const p = t.params;
    const s = t.source;
    if (s === 'local') {
      p.voice = el.querySelector('[data-param="voice"]')?.value || '';
      p.rate = parseFloat(el.querySelector('[data-param="rate"]')?.value || 1);
      p.pitch = parseFloat(el.querySelector('[data-param="pitch"]')?.value || 1);
      p.volume = parseFloat(el.querySelector('[data-param="volume"]')?.value || 1);
    } else if (s === 'edge') {
      p.edgeVoice = el.querySelector('[data-param="edgeVoice"]')?.value || 'zh-CN-XiaoxiaoNeural';
      p.edgeStyle = el.querySelector('[data-param="edgeStyle"]')?.value || 'general';
      p.edgeRate = parseInt(el.querySelector('[data-param="edgeRate"]')?.value || 0);
      p.edgePitch = parseInt(el.querySelector('[data-param="edgePitch"]')?.value || 0);
    } else if (s === 'aliyun') {
      p.aliVoice = el.querySelector('[data-param="aliVoice"]')?.value || 'zhixiaoning';
      p.aliRate = parseInt(el.querySelector('[data-param="aliRate"]')?.value || 0);
      p.aliPitch = parseInt(el.querySelector('[data-param="aliPitch"]')?.value || 0);
      p.aliVolume = parseInt(el.querySelector('[data-param="aliVolume"]')?.value || 50);
      p.aliEmotion = el.querySelector('[data-param="aliEmotion"]')?.value || 'neutral';
    } else if (s === 'openai') {
      p.oaVoice = el.querySelector('[data-param="oaVoice"]')?.value || 'alloy';
      p.oaSpeed = parseFloat(el.querySelector('[data-param="oaSpeed"]')?.value || 1);
    } else if (s === 'azure') {
      p.azVoice = el.querySelector('[data-param="azVoice"]')?.value || 'zh-CN-XiaoxiaoNeural';
      p.azStyle = el.querySelector('[data-param="azStyle"]')?.value || 'general';
      p.azRate = parseInt(el.querySelector('[data-param="azRate"]')?.value || 0);
      p.azPitch = parseInt(el.querySelector('[data-param="azPitch"]')?.value || 0);
    } else if (s === 'localapi') {
      p.lapiVoice = el.querySelector('[data-param="lapiVoice"]')?.value || 'default';
      p.lapiRate = parseFloat(el.querySelector('[data-param="lapiRate"]')?.value || 1);
      p.lapiParams = el.querySelector('[data-param="lapiParams"]')?.value || '';
    }
  }

  function renderTrack(track) {
    const list = document.getElementById('track-list');
    const cfg = SOURCE_CONFIG[track.source];

    const div = document.createElement('div');
    div.id = `track-${track.id}`;
    div.className = 'rounded-xl border border-(--line-divider) bg-(--card-bg) overflow-hidden';

    // 构建参数HTML
    let paramsHtml = '';
    if (track.source === 'local') {
      paramsHtml = `
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <div>
            <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">声音</label>
            <select data-param="voice" class="w-full rounded-lg bg-(--bg) border border-(--line-divider) px-2 py-1.5 text-sm text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary)">
              <option value="">默认</option>
            </select>
          </div>
          <div><label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">语速 <span class="val-rate">${track.params.rate}</span></label><input data-param="rate" type="range" min="0.5" max="2" step="0.1" value="${track.params.rate}" class="w-full accent-(--primary)"></div>
          <div><label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">音高 <span class="val-pitch">${track.params.pitch}</span></label><input data-param="pitch" type="range" min="0.5" max="2" step="0.1" value="${track.params.pitch}" class="w-full accent-(--primary)"></div>
          <div><label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">音量 <span class="val-volume">${track.params.volume}</span></label><input data-param="volume" type="range" min="0" max="1" step="0.1" value="${track.params.volume}" class="w-full accent-(--primary)"></div>
        </div>`;
    } else if (track.source === 'edge') {
      paramsHtml = `
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <div>
            <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">声音</label>
            <select data-param="edgeVoice" class="w-full rounded-lg bg-(--bg) border border-(--line-divider) px-2 py-1.5 text-sm text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary)">
              ${EDGE_VOICES.map(v => `<option value="${v.v}" ${v.v===track.params.edgeVoice?'selected':''}>${v.n}</option>`).join('')}
            </select>
          </div>
          <div>
            <label class="block text-xs text-neutral-500 dark:text-neutral-400 mb-1">说话风格</label>
            <select data-param="edgeStyle" class="w-full rounded-lg bg-(--bg) border border-(--line-divider) px-2 py-1.5 text-sm text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-(--primary)">
              ${EDGE_STYLES.map(s => `<option value="${s}" ${s===track.params.edgeStyle?'selected':''}>${s}</option>`).join('')}
            </select>
          </div>
