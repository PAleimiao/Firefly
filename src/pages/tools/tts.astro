  function bindTrackEvents(el, track) {
    // 文本和源变更
    el.querySelector('.track-text').addEventListener('input', () => updateTrackData(track.id));
    el.querySelector('.track-source').addEventListener('change', () => {
      updateTrackData(track.id);
      // 重新渲染参数区
      const t = tracks.find(tr => tr.id === track.id);
      t.params = getDefaultParams(t.source);
      el.querySelector('.track-params').innerHTML = buildParamsHtml(t);
      bindParamsEvents(el, track);
      // 更新下载按钮状态
      const cfg = SOURCE_CONFIG[t.source];
      const dlBtn = el.querySelector('.track-dl');
      dlBtn.disabled = !cfg.hasDownload;
      dlBtn.classList.toggle('opacity-50', !cfg.hasDownload);
      dlBtn.classList.toggle('cursor-not-allowed', !cfg.hasDownload);
      // 如果是local，加载声音
      if (t.source === 'local') {
        setTimeout(() => loadLocalVoices(el.querySelector('[data-param="voice"]'), ''), 100);
      }
    });

    bindParamsEvents(el, track);

    // 按钮
    el.querySelector('.track-del').addEventListener('click', () => removeTrack(track.id));
    el.querySelector('.track-dup').addEventListener('click', () => duplicateTrack(track.id));
    el.querySelector('.track-up').addEventListener('click', () => moveTrack(track.id, -1));
    el.querySelector('.track-down').addEventListener('click', () => moveTrack(track.id, 1));
    el.querySelector('.track-play').addEventListener('click', () => playTrack(track.id));
    el.querySelector('.track-dl').addEventListener('click', () => downloadTrack(track.id));
  }

