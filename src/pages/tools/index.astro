---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

const tools = [
  {
    name: "每日一签",
    desc: "今日运势、宜忌事项、幸运物推荐，每天抽一签看看运气如何。",
    url: "/tools/daily/",
    icon: "material-symbols:stars",
    color: "#f59e0b",
    tag: "运势"
  },
  {
    name: "废话生成器",
    desc: "一键生成废话文学、彩虹屁、毒鸡汤，复制粘贴就能用。",
    url: "/tools/nonsense/",
    icon: "material-symbols:chat-bubble",
    color: "#8b5cf6",
    tag: "文案"
  },
  {
    name: "语音合成工坊",
    desc: "多引擎TTS：Edge/阿里云/OpenAI/Azure/本地API，支持多音轨混音导出。",
    url: "/tools/tts/",
    icon: "material-symbols:record-voice-over",
    color: "#10b981",
    tag: "音频"
  },
  {
    name: "音频转换",
    desc: "浏览器本地音频格式转换，支持MP3/WAV/OGG等格式互转。",
    url: "/tools/audio-convert/",
    icon: "material-symbols:audio-file",
    color: "#06b6d4",
    tag: "音频"
  },
  {
    name: "谱面查看器",
    desc: "在线查看Phira谱面结构，解析JSON谱面数据，可视化音符排列。",
    url: "/tools/chart-viewer/",
    icon: "material-symbols:music-note",
    color: "#ec4899",
    tag: "音游"
  },
  {
    name: "PMX 动画工坊",
    desc: "浏览器里的迷你MMD舞台，导入PMX模型和VMD动作，摆骨骼捏表情。",
    url: "/tools/pmx-studio/",
    icon: "material-symbols:theater-comedy",
    color: "#f97316",
    tag: "3D"
  },
  {
    name: "视频剪辑工坊",
    desc: "纯浏览器视频剪辑：多段拼接、滤镜特效、文字水印、本地合成导出。",
    url: "/tools/video-editor/",
    icon: "material-symbols:movie-edit",
    color: "#ef4444",
    tag: "视频"
  }
];
---

<MainGridLayout title="工具工坊" description="避难所的工具集合：语音合成、视频剪辑、废话生成、每日运势、谱面查看、PMX动画、音频转换。全部在浏览器里运行。">
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative w-full">

      <!-- 标题 -->
      <div class="flex items-center gap-3 mb-2">
        <div class="h-10 w-10 rounded-xl bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
          <Icon is:inline name="material-symbols:construction" class="text-[1.75rem]"></Icon>
        </div>
        <div>
          <div class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">工具工坊</div>
          <div class="text-sm text-neutral-500 dark:text-neutral-400">{tools.length} 个工具 · 全部在浏览器本地运行</div>
        </div>
      </div>

      <!-- 简介 -->
      <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-6 max-w-2xl leading-relaxed">
        这里是避难所的工具集合。所有工具都在你的设备上运行，数据不会上传服务器。
        从语音合成到视频剪辑，从废话生成到3D动画，应有尽有。
      </p>

      <!-- 工具卡片网格 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {tools.map((tool) => (
          <a 
            href={tool.url}
            class="group rounded-xl border border-(--line-divider) bg-(--card-bg) p-5 hover:border-(--primary)/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg relative overflow-hidden"
          >
            <!-- 装饰色块 -->
            <div 
              class="absolute top-0 right-0 w-24 h-24 rounded-full opacity-5 -translate-y-1/2 translate-x-1/2 transition-transform duration-500 group-hover:scale-150"
              style={`background-color: ${tool.color}`}
            ></div>

            <div class="flex items-start gap-4 relative z-10">
              <div 
                class="h-12 w-12 rounded-xl flex items-center justify-center text-white shrink-0 transition-transform duration-300 group-hover:scale-110"
                style={`background-color: ${tool.color}`}
              >
                <Icon is:inline name={tool.icon} class="text-[1.5rem]"></Icon>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-bold text-neutral-900 dark:text-neutral-100 text-base">{tool.name}</span>
                  <span 
                    class="text-xs px-2 py-0.5 rounded-full font-medium"
                    style={`background-color: ${tool.color}15; color: ${tool.color}`}
                  >
                    {tool.tag}
                  </span>
                </div>
                <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed line-clamp-2">
                  {tool.desc}
                </p>
              </div>
            </div>

            <!-- 底部箭头 -->
            <div class="flex items-center justify-end mt-4 relative z-10">
              <span class="text-xs text-neutral-400 dark:text-neutral-500 flex items-center gap-1 group-hover:text-(--primary) transition-colors">
                进入工具
                <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- 底部提示 -->
      <div class="mt-6 rounded-xl border border-(--line-divider) bg-(--bg) px-5 py-4 flex items-center gap-3">
        <svg class="w-5 h-5 text-(--primary) shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
          💡 所有工具均为纯前端实现，数据保存在本地浏览器中。如有功能建议或Bug反馈，欢迎去
          <a href="/guestbook/" class="text-(--primary) hover:underline">留言板</a>
          留言。
        </p>
      </div>

    </div>
  </div>
</MainGridLayout>
