---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="404 - 页面走丢了" description="你要找的页面不存在，但它可能去避难所躲起来了。">
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-[500px]">
    <div class="card-base z-10 px-6 sm:px-9 py-12 sm:py-16 relative w-full flex flex-col items-center justify-center text-center">

      <!-- 404 大号数字 -->
      <div class="text-8xl sm:text-9xl font-black text-(--primary) opacity-15 mb-2 select-none" style="line-height: 1;">
        404
      </div>

      <!-- 图标 -->
      <div class="mb-4 -mt-8">
        <div class="h-16 w-16 rounded-2xl bg-(--primary)/10 flex items-center justify-center">
          <Icon is:inline name="material-symbols:travel-explore" class="text-[2.5rem] text-(--primary)"></Icon>
        </div>
      </div>

      <!-- 标题 -->
      <div class="text-2xl sm:text-3xl font-bold mb-3 text-neutral-900 dark:text-neutral-100">
        页面走丢了 🤷
      </div>

      <!-- 描述 -->
      <p class="text-base text-neutral-500 dark:text-neutral-400 mb-8 max-w-md leading-relaxed">
        你要找的页面不存在，但它可能去避难所躲起来了。<br>
        或者……被Kimi3搞崩了？😂
      </p>

      <!-- 按钮组 -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a 
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-(--primary) text-white dark:text-black/70 font-medium hover:opacity-85 active:scale-95 transition text-sm"
        >
          <Icon is:inline name="material-symbols:home" class="text-[1.1rem]"></Icon>
          返回避难所首页
        </a>
        <a 
          href="/watch/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-(--btn-regular-bg) text-(--btn-content) border border-(--line-divider) font-medium hover:opacity-85 active:scale-95 transition text-sm"
        >
          <Icon is:inline name="material-symbols:tv" class="text-[1.1rem]"></Icon>
          去看番
        </a>
        <a 
          href="/tools/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-(--btn-regular-bg) text-(--btn-content) border border-(--line-divider) font-medium hover:opacity-85 active:scale-95 transition text-sm"
        >
          <Icon is:inline name="material-symbols:construction" class="text-[1.1rem]"></Icon>
          去工坊
        </a>
      </div>

      <!-- 装饰 -->
      <div class="absolute top-4 left-4 opacity-5">
        <Icon is:inline name="material-symbols:sentiment-dissatisfied" class="text-[3rem] text-(--primary)"></Icon>
      </div>
      <div class="absolute bottom-4 right-4 opacity-5">
        <Icon is:inline name="material-symbols:broken-image" class="text-[3rem] text-(--primary)"></Icon>
      </div>

    </div>
  </div>
</MainGridLayout>

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .card-base {
    animation: fadeInUp 0.5s ease-out;
  }
</style>
