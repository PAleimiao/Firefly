---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import gameData from "@/data/gameData.json";

export function getStaticPaths() {
  return gameData.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const title = `${game.title} - 游戏站`;
---

<MainGridLayout title={title} description={game.description}>
  <div class="max-w-5xl mx-auto px-4 py-6">
    <a 
      href="/games/" 
      class="inline-flex items-center gap-2 text-white/60 hover:text-white mb-4 transition-colors"
    >
      <span>←</span> 返回游戏列表
    </a>

    <div class="mb-4">
      <h1 class="text-2xl font-bold mb-1">{game.title}</h1>
      <p class="text-white/60 text-sm">{game.description}</p>
    </div>

    <div class="rounded-xl overflow-hidden bg-black/50 border border-white/10 relative" style="aspect-ratio: 16/10;">
      <iframe
        src={game.filePath}
        class="w-full h-full border-0"
        title={game.title}
        allow="autoplay; fullscreen"
        sandbox="allow-scripts allow-same-origin allow-popups"
      ></iframe>
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      <span class="text-xs bg-white/10 px-3 py-1 rounded-full text-white/70">分类: {game.category}</span>
      <span class="text-xs bg-white/10 px-3 py-1 rounded-full text-white/70">即点即玩</span>
    </div>
  </div>
</MainGridLayout>