---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import gameData from "@/data/gameData.json";

const title = "游戏站";
const description = "CXL 避难所小游戏合集，点击即玩";
---

<MainGridLayout title={title} description={description}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-2">{title}</h1>
      <p class="text-white/60">{description}</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {gameData.map((game) => (
        <a 
          href={`/games/${game.slug}/`}
          class="group block rounded-xl overflow-hidden bg-white/5 hover:bg-white/10 transition-all duration-300 hover:scale-[1.02]"
        >
          <div class="aspect-[4/3] overflow-hidden relative bg-gradient-to-br from-white/5 to-white/10 flex items-center justify-center">
            <span class="text-4xl opacity-30 group-hover:opacity-50 transition-opacity">
              {game.category === "音乐" ? "🎹" : game.category === "益智" ? "🧩" : game.category === "街机" ? "🕹️" : "🎮"}
            </span>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-300 flex items-center justify-center">
              <span class="opacity-0 group-hover:opacity-100 text-white font-bold text-lg transform translate-y-2 group-hover:translate-y-0 transition-all duration-300">
                ▶ 开始游戏
              </span>
            </div>
          </div>
          <div class="p-3">
            <div class="flex items-center gap-2 mb-1">
              <h3 class="font-bold text-sm line-clamp-1">{game.title}</h3>
              <span class="text-[10px] bg-white/10 px-1.5 py-0.5 rounded text-white/50">{game.category}</span>
            </div>
            <p class="text-xs text-white/50 line-clamp-2">{game.description}</p>
          </div>
        </a>
      ))}
    </div>

    {gameData.length === 0 && (
      <div class="text-center py-20 text-white/40">
        <p class="text-lg mb-2">暂时没有游戏</p>
        <p class="text-sm">去后台添加数据吧~</p>
      </div>
    )}
  </div>
</MainGridLayout>