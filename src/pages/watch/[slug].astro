---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import animeData from "@/data/animeData.json";

export function getStaticPaths() {
  return animeData.map((anime) => ({
    params: { slug: anime.slug },
    props: { anime },
  }));
}

const { anime } = Astro.props;
const title = `${anime.title} - 看番`;
---

<MainGridLayout title={title} description={anime.description}>
  <div class="max-w-5xl mx-auto px-4 py-6">
    <a 
      href="/watch/" 
      class="inline-flex items-center gap-2 text-white/60 hover:text-white mb-4 transition-colors"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      返回番剧列表
    </a>

    <!-- 播放器容器 -->
    <div 
      id="player-wrapper" 
      class="rounded-xl overflow-hidden bg-black mb-6 aspect-video relative select-none cursor-pointer group"
    >
      <video
        id="anime-player"
        class="w-full h-full"
        poster={anime.cover}
        preload="metadata"
        playsinline
      >
        <source src={anime.episodes[0]?.url} type="video/mp4" />
        你的浏览器不支持视频播放
      </video>

      <!-- 加载中 -->
      <div id="vp-loading" class="absolute inset-0 flex items-center justify-center bg-black/50 hidden z-20">
        <div class="w-10 h-10 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
      </div>

      <!-- 快进/快退提示 -->
      <div id="vp-skip-hint" class="absolute top-1/2 -translate-y-1/2 px-4 py-2 rounded-lg bg-black/70 text-white font-bold text-lg hidden z-20 pointer-events-none">
        <span id="vp-skip-text"></span>
      </div>

      <!-- 倍速提示 -->
      <div id="vp-speed-hint" class="absolute top-4 right-4 px-3 py-1.5 rounded-lg bg-black/70 text-white text-sm font-medium hidden z-20 pointer-events-none">
        ⚡ 2.0x
      </div>

      <!-- 手势区域遮罩（用于双击和长按） -->
      <div id="vp-gesture" class="absolute inset-0 z-10"></div>

      <!-- 顶部标题栏（悬停显示） -->
      <div id="vp-top-bar" class="absolute top-0 left-0 right-0 px-4 py-3 bg-gradient-to-b from-black/70 to-transparent text-white text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20 pointer-events-none">
        {anime.title}
      </div>

      <!-- 中间播放按钮（暂停时显示） -->
      <div id="vp-big-play" class="absolute inset-0 flex items-center justify-center z-20 hidden">
        <div class="w-16 h-16 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center hover:bg-white/30 transition">
          <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </div>
      </div>

      <!-- 底部控制栏 -->
      <div id="vp-controls" class="absolute bottom-0 left-0 right-0 px-4 pb-3 pt-8 bg-gradient-to-t from-black/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20">

        <!-- 进度条 -->
        <div class="relative mb-3 group/progress">
          <div id="vp-progress-bg" class="h-1 bg-white/20 rounded-full cursor-pointer">
            <div id="vp-progress-fill" class="h-full bg-(--primary) rounded-full relative" style="width: 0%;">
              <div class="absolute right-0 top-1/2 -translate-y-1/2 w-3 h-3 bg-white rounded-full opacity-0 group-hover/progress:opacity-100 transition-opacity shadow"></div>
            </div>
          </div>
          <!-- 悬停时间提示 -->
          <div id="vp-hover-time" class="absolute -top-8 px-2 py-1 rounded bg-black/80 text-white text-xs hidden pointer-events-none transform -translate-x-1/2"></div>
        </div>

        <!-- 控制按钮行 -->
        <div class="flex items-center gap-3">
          <!-- 播放/暂停 -->
          <button id="vp-play-btn" class="text-white hover:text-(--primary) transition">
            <svg id="vp-icon-play" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            <svg id="vp-icon-pause" class="w-6 h-6 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
          </button>

          <!-- 时间 -->
          <span class="text-white/80 text-xs font-mono">
            <span id="vp-cur-time">0:00</span> / <span id="vp-total-time">0:00</span>
          </span>

          <div class="flex-1"></div>

          <!-- 快退10秒 -->
          <button id="vp-skip-back" class="text-white/70 hover:text-white transition text-xs flex items-center gap-1" title="快退10秒 (←)">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M11 18V6l-8.5 6 8.5 6zm.5-6l8.5 6V6l-8.5 6z"/></svg>
            10s
          </button>

          <!-- 快进10秒 -->
          <button id="vp-skip-forward" class="text-white/70 hover:text-white transition text-xs flex items-center gap-1" title="快进10秒 (→)">
            10s
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M4 18l8.5-6L4 6v12zm9-12v12l8.5-6L13 6z"/></svg>
          </button>

          <!-- 倍速 -->
          <div class="relative">
            <button id="vp-speed-btn" class="text-white/70 hover:text-white transition text-xs px-2 py-1 rounded hover:bg-white/10">
              1.0x
            </button>
            <div id="vp-speed-menu" class="absolute bottom-full right-0 mb-1 bg-black/90 rounded-lg overflow-hidden hidden text-xs min-w-[60px]">
              <button data-speed="0.5" class="speed-opt block w-full px-3 py-2 text-white/70 hover:bg-white/10 hover:text-white text-center">0.5x</button>
              <button data-speed="1.0" class="speed-opt block w-full px-3 py-2 text-(--primary) bg-white/10 text-center">1.0x</button>
              <button data-speed="1.25" class="speed-opt block w-full px-3 py-2 text-white/70 hover:bg-white/10 hover:text-white text-center">1.25x</button>
              <button data-speed="1.5" class="speed-opt block w-full px-3 py-2 text-white/70 hover:bg-white/10 hover:text-white text-center">1.5x</button>
              <button data-speed="2.0" class="speed-opt block w-full px-3 py-2 text-white/70 hover:bg-white/10 hover:text-white text-center">2.0x</button>
            </div>
          </div>

          <!-- 全屏 -->
          <button id="vp-fullscreen" class="text-white/70 hover:text-white transition">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="mb-6">
      <h1 class="text-2xl font-bold mb-2">{anime.title}</h1>
      <p class="text-white/60">{anime.description}</p>
    </div>

    <div class="mb-8">
      <h2 class="text-lg font-bold mb-3 flex items-center gap-2">
        <span>选集</span>
        <span class="text-xs bg-white/10 px-2 py-0.5 rounded-full">共 {anime.episodes.length} 集</span>
      </h2>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-2">
        {anime.episodes.map((ep, index) => (
          <button
            class="episode-btn group relative p-3 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-all text-left"
            data-url={ep.url}
            data-index={index}
          >
            <div class="text-xs text-white/40 mb-1">第 {index + 1} 集</div>
            <div class="text-sm font-medium line-clamp-2 group-hover:text-white transition-colors">
              {ep.title.replace(`第${index + 1}集 `, '')}
            </div>
            <div class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 text-white/60 text-xs">
              ▶
            </div>
          </button>
        ))}
      </div>
    </div>
  </div>

  <script define:vars={{ episodes: anime.episodes }}>
    const player = document.getElementById('anime-player');
    const source = player.querySelector('source');
    const wrapper = document.getElementById('player-wrapper');
    const gesture = document.getElementById('vp-gesture');
    const controls = document.getElementById('vp-controls');
    const playBtn = document.getElementById('vp-play-btn');
    const iconPlay = document.getElementById('vp-icon-play');
    const iconPause = document.getElementById('vp-icon-pause');
    const bigPlay = document.getElementById('vp-big-play');
    const progressBg = document.getElementById('vp-progress-bg');
    const progressFill = document.getElementById('vp-progress-fill');
    const curTimeEl = document.getElementById('vp-cur-time');
    const totalTimeEl = document.getElementById('vp-total-time');
    const skipHint = document.getElementById('vp-skip-hint');
    const skipText = document.getElementById('vp-skip-text');
    const speedHint = document.getElementById('vp-speed-hint');
    const speedBtn = document.getElementById('vp-speed-btn');
    const speedMenu = document.getElementById('vp-speed-menu');
    const hoverTime = document.getElementById('vp-hover-time');
    const buttons = document.querySelectorAll('.episode-btn');
    let currentIndex = 0;
    let isPlaying = false;
    let longPressTimer = null;
    let isLongPress = false;
    let hideControlsTimer = null;

    function formatTime(t) {
      if (!isFinite(t)) return '0:00';
      const m = Math.floor(t / 60);
      const s = Math.floor(t % 60);
      return m + ':' + (s < 10 ? '0' : '') + s;
    }

    function updatePlayState() {
      isPlaying = !player.paused;
      if (isPlaying) {
        iconPlay.classList.add('hidden');
        iconPause.classList.remove('hidden');
        bigPlay.classList.add('hidden');
      } else {
        iconPlay.classList.remove('hidden');
        iconPause.classList.add('hidden');
        bigPlay.classList.remove('hidden');
      }
    }

    function showControls() {
      controls.style.opacity = '1';
      clearTimeout(hideControlsTimer);
      if (isPlaying) {
        hideControlsTimer = setTimeout(() => {
          controls.style.opacity = '';
        }, 3000);
      }
    }

    // 播放/暂停
    function togglePlay() {
      if (player.paused) {
        player.play().catch(() => {});
      } else {
        player.pause();
      }
    }

    playBtn.addEventListener('click', (e) => { e.stopPropagation(); togglePlay(); });
    bigPlay.addEventListener('click', (e) => { e.stopPropagation(); togglePlay(); });

    player.addEventListener('play', updatePlayState);
    player.addEventListener('pause', updatePlayState);
    player.addEventListener('waiting', () => document.getElementById('vp-loading').classList.remove('hidden'));
    player.addEventListener('playing', () => document.getElementById('vp-loading').classList.add('hidden'));
    player.addEventListener('canplay', () => document.getElementById('vp-loading').classList.add('hidden'));

    // 进度更新
    player.addEventListener('timeupdate', () => {
      const pct = player.duration ? (player.currentTime / player.duration) * 100 : 0;
      progressFill.style.width = pct + '%';
      curTimeEl.textContent = formatTime(player.currentTime);
      totalTimeEl.textContent = formatTime(player.duration || 0);
    });

    // 进度条点击/拖动
    progressBg.addEventListener('click', (e) => {
      const rect = progressBg.getBoundingClientRect();
      const pct = (e.clientX - rect.left) / rect.width;
      player.currentTime = pct * player.duration;
    });

    progressBg.addEventListener('mousemove', (e) => {
      const rect = progressBg.getBoundingClientRect();
      const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      hoverTime.style.left = (pct * 100) + '%';
      hoverTime.textContent = formatTime(pct * player.duration);
      hoverTime.classList.remove('hidden');
    });

    progressBg.addEventListener('mouseleave', () => {
      hoverTime.classList.add('hidden');
    });

    // ========== 双击快进/快退 ==========
    let lastClickTime = 0;
    let lastClickX = 0;

    gesture.addEventListener('click', (e) => {
      const now = Date.now();
      const rect = wrapper.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const isRight = x > rect.width / 2;

      // 检测双击（300ms内同侧第二次点击）
      if (now - lastClickTime < 300 && Math.abs(x - lastClickX) < 50) {
        e.stopPropagation();
        if (isRight) {
          // 双击右半屏 → 快进10秒
          player.currentTime = Math.min(player.duration || Infinity, player.currentTime + 10);
          showSkipHint('+10s', 'right');
        } else {
          // 双击左半屏 → 快退10秒
          player.currentTime = Math.max(0, player.currentTime - 10);
          showSkipHint('-10s', 'left');
        }
        lastClickTime = 0;
        return;
      }

      lastClickTime = now;
      lastClickX = x;

      // 单击播放/暂停（延迟执行，给双击检测留时间）
      setTimeout(() => {
        if (Date.now() - lastClickTime >= 300) {
          togglePlay();
        }
      }, 310);
    });

    function showSkipHint(text, side) {
      skipText.textContent = text;
      skipHint.style.left = side === 'right' ? 'auto' : '20px';
      skipHint.style.right = side === 'right' ? '20px' : 'auto';
      skipHint.classList.remove('hidden');
      setTimeout(() => skipHint.classList.add('hidden'), 800);
    }

    // ========== 长按快进（2倍速） ==========
    gesture.addEventListener('mousedown', startLongPress);
    gesture.addEventListener('touchstart', startLongPress, { passive: true });
    gesture.addEventListener('mouseup', endLongPress);
    gesture.addEventListener('mouseleave', endLongPress);
    gesture.addEventListener('touchend', endLongPress);

    function startLongPress(e) {
      isLongPress = false;
      longPressTimer = setTimeout(() => {
        isLongPress = true;
        player.playbackRate = 2.0;
        speedHint.classList.remove('hidden');
        // 震动反馈（如果支持）
        if (navigator.vibrate) navigator.vibrate(50);
      }, 500);
    }

    function endLongPress() {
      clearTimeout(longPressTimer);
      if (isLongPress) {
        player.playbackRate = parseFloat(speedBtn.dataset.speed || '1.0');
        speedHint.classList.add('hidden');
        isLongPress = false;
      }
    }

    // ========== 键盘快捷键 ==========
    document.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

      switch(e.key) {
        case ' ':
        case 'k':
          e.preventDefault();
          togglePlay();
          break;
        case 'ArrowLeft':
          e.preventDefault();
          player.currentTime = Math.max(0, player.currentTime - 5);
          showSkipHint('-5s', 'left');
          break;
        case 'ArrowRight':
          e.preventDefault();
          player.currentTime = Math.min(player.duration || Infinity, player.currentTime + 5);
          showSkipHint('+5s', 'right');
          break;
        case 'j':
          player.currentTime = Math.max(0, player.currentTime - 10);
          showSkipHint('-10s', 'left');
          break;
        case 'l':
          player.currentTime = Math.min(player.duration || Infinity, player.currentTime + 10);
          showSkipHint('+10s', 'right');
          break;
        case 'f':
          toggleFullscreen();
          break;
        case 'm':
          player.muted = !player.muted;
          break;
      }
    });

    // ========== 倍速菜单 ==========
    speedBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      speedMenu.classList.toggle('hidden');
    });

    document.querySelectorAll('.speed-opt').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const speed = parseFloat(btn.dataset.speed);
        player.playbackRate = speed;
        speedBtn.dataset.speed = speed;
        speedBtn.textContent = speed + 'x';
        speedMenu.classList.add('hidden');
        // 更新高亮
        document.querySelectorAll('.speed-opt').forEach(b => {
          b.classList.remove('text-(--primary)', 'bg-white/10');
          b.classList.add('text-white/70');
        });
        btn.classList.add('text-(--primary)', 'bg-white/10');
        btn.classList.remove('text-white/70');
      });
    });

    document.addEventListener('click', () => speedMenu.classList.add('hidden'));

    // ========== 全屏 ==========
    function toggleFullscreen() {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else {
        wrapper.requestFullscreen();
      }
    }

    document.getElementById('vp-fullscreen').addEventListener('click', (e) => {
      e.stopPropagation();
      toggleFullscreen();
    });

    // ========== 选集 ==========
    function playEpisode(index) {
      const ep = episodes[index];
      if (!ep) return;

      source.src = ep.url;
      player.load();
      player.play().catch(() => {});

      buttons.forEach((btn, i) => {
        if (i === index) {
          btn.classList.add('bg-white/20', 'border-white/40');
          btn.classList.remove('bg-white/5', 'border-white/10');
        } else {
          btn.classList.remove('bg-white/20', 'border-white/40');
          btn.classList.add('bg-white/5', 'border-white/10');
        }
      });

      currentIndex = index;
    }

    if (buttons[0]) {
      buttons[0].classList.add('bg-white/20', 'border-white/40');
      buttons[0].classList.remove('bg-white/5', 'border-white/10');
    }

    buttons.forEach((btn, index) => {
      btn.addEventListener('click', () => playEpisode(index));
    });

    player.addEventListener('ended', () => {
      if (currentIndex + 1 < episodes.length) {
        playEpisode(currentIndex + 1);
      }
    });

    // 初始化
    updatePlayState();
  </script>
</MainGridLayout>
